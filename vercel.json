{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "icn1"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ieltswithharry.vercel.app"
        }
      ],
      "destination": "https://harryup.vercel.app/:path*",
      "permanent": true
    }
  ]
}
