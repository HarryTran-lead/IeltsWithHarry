      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "Keep the February sensor values with a note that the probe drifted during the final week. The earlier readings are still usable.",
      "meaning_vi": "A: Giữ số liệu tháng Hai kèm lưu ý cảm biến lệch cuối tuần.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
