      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T16",
      "speaker_id": "C",
      "text_en": "We need the engineering department to confirm who owns the upper drain before anyone installs equipment there.",
      "meaning_vi": "C: Cần cơ quan kỹ thuật xác nhận quyền quản lý cống.",
