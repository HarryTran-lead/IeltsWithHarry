    {
      "turn_id": "T01",
      "speaker_id": "C",
      "text_en": "The council is considering restoration along a short urban stream.",
      "meaning_vi": "C: Hội đồng cân nhắc phục hồi suối đô thị; dữ liệu và ý kiến cư dân gợi nhiều ưu tiên.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
