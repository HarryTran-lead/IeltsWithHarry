      "discourse_role": "evidence"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "We should state the maintenance threshold clearly: at what point must the trap be emptied, and what observation would show it is no longer performing as intended?",
      "meaning_vi": "A: Cần quy định mức bùn nào phải dọn và dấu hiệu bẫy ngừng hiệu quả.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
