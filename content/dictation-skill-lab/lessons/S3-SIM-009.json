    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "The proposal should state what would count as failure, not just what success might look like.",
      "meaning_vi": "B: Đề xuất phải nêu thế nào là thất bại chứ không chỉ thành công.",
