  ],
  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "Good afternoon, Greenwheel Car Share. Alex speaking. Have you already registered, or would you like to find out how membership works?",
      "translation_vi": "Chào chiều, Dịch vụ xe chung Greenwheel, Alex đây. Chị đã đăng ký hay muốn tìm hiểu hội viên?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "I'd like to join. My own car is rarely used, but I occasionally need one to visit my aunt outside the city.",
      "translation_vi": "Tôi muốn tham gia. Xe riêng ít dùng, nhưng thỉnh thoảng cần xe thăm dì ở ngoại ô.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "Our entry plan is called Neighbour. It's meant for occasional trips, while the Commuter plan suits people who drive every day.",
      "translation_vi": "Gói cơ bản tên Neighbour, dành cho đi không thường xuyên; gói Commuter dành cho người lái mỗi ngày.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "Neighbour sounds right. I probably need a vehicle only twice a month, and my journeys usually take half a day.",
      "translation_vi": "Neighbour có vẻ đúng. Có lẽ tôi cần xe hai lần mỗi tháng, mỗi lần nửa ngày.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T05",
      "speaker_id": "A",
      "text_en": "The annual membership is twenty-four pounds. That's separate from hourly hire; the daily-driver plan has a higher joining fee.",
      "translation_vi": "Hội viên năm là hai mươi bốn bảng, tách biệt tiền thuê theo giờ; gói lái hằng ngày có phí tham gia cao hơn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "Fair enough. I saw a car parked near the library. Is that the closest pick-up point for the Riverside neighbourhood?",
      "translation_vi": "Được. Tôi thấy xe gần thư viện. Đó là điểm lấy gần nhất khu Riverside phải không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T07",
      "speaker_id": "A",
      "text_en": "It used to be, but we've moved that car to Oak Square. The old library bay is now reserved for delivery vehicles.",
      "translation_vi": "Trước đây đúng, nhưng xe đã chuyển sang Oak Square. Ô gần thư viện giờ dành cho xe giao hàng.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "Oak Square is still walkable for me. Do members collect keys from an office, or is everything operated by phone?",
      "translation_vi": "Oak Square vẫn đi bộ đến được. Hội viên lấy chìa ở văn phòng hay điều khiển qua điện thoại?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T09",
      "speaker_id": "A",
      "text_en": "You unlock the car using our app. The physical key stays inside a small holder, and you return it there after driving.",
      "translation_vi": "Mở xe qua ứng dụng. Chìa khóa nằm trong giá giữ nhỏ và trả lại sau khi lái.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "I can use an app. I recently renewed my licence, though the card itself hasn't arrived in the post yet.",
      "translation_vi": "Tôi dùng ứng dụng được. Tôi mới gia hạn giấy phép lái xe nhưng thẻ chưa gửi tới.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "For approval we need a photograph of a valid driving licence. A renewal confirmation letter isn't enough on its own.",
      "translation_vi": "Để duyệt cần ảnh giấy phép lái xe còn hiệu lực. Thư xác nhận gia hạn thôi chưa đủ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T12",
      "speaker_id": "B",
      "text_en": "I'll wait for the card. What's the youngest driver you allow? My brother might want to share my account later.",
      "translation_vi": "Tôi đợi thẻ. Tuổi lái thấp nhất là bao nhiêu? Em trai có thể muốn dùng chung tài khoản sau này.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "Drivers must be at least twenty-three. Each driver needs their own membership, so your brother couldn't simply use your login.",
      "translation_vi": "Người lái phải ít nhất hai mươi ba tuổi. Mỗi người cần tài khoản riêng, em không thể dùng đăng nhập của chị.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T14",
      "speaker_id": "B",
      "text_en": "He's twenty-one, so he won't be eligible yet. Could I still book for a Saturday trip once my application is approved?",
      "translation_vi": "Em mới hai mươi mốt nên chưa đủ điều kiện. Tôi có thể đặt chuyến thứ Bảy sau khi được duyệt chứ?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "Yes, and the minimum booking is one hour. There's no separate charge for the first thirty miles of any booking.",
      "translation_vi": "Có, thời lượng thuê tối thiểu một giờ. Ba mươi dặm đầu tiên không có phụ phí riêng.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "That's enough for local trips. I worry about bringing the vehicle back late if traffic is particularly bad.",
      "translation_vi": "Đủ cho chuyến gần. Tôi lo trả xe muộn nếu giao thông tắc.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "You can extend the reservation in the app, provided no one else has booked the car. Otherwise you must contact our support line.",
      "translation_vi": "Chị có thể gia hạn trong ứng dụng nếu không ai đặt tiếp. Nếu có thì phải gọi hỗ trợ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "Good to know. Are members expected to refuel before every return? My aunt lives near a petrol station.",
      "translation_vi": "Tốt. Hội viên cần đổ xăng trước mỗi lần trả không? Nhà dì tôi gần trạm xăng.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "Please return the car with at least a quarter tank. A fuel card is in the glove compartment, so you shouldn't pay personally.",
      "translation_vi": "Hãy trả xe với ít nhất một phần tư bình. Thẻ nhiên liệu trong hộc trước, không phải tự trả.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "That seems reasonable. I'm also worried about scratches from other drivers. How do I report damage already on the car?",
      "translation_vi": "Hợp lý. Tôi lo vết xước của người trước. Làm sao báo hư hỏng sẵn có?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T21",
      "speaker_id": "A",
      "text_en": "Before leaving the bay, take photographs in the app. That creates a record, so you aren't held responsible for damage you didn't cause.",
      "translation_vi": "Trước khi rời bãi, chụp ảnh trong ứng dụng. Việc đó tạo hồ sơ để chị không chịu trách nhiệm vết xước có sẵn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T22",
      "speaker_id": "B",
      "text_en": "I'll remember that. Please email the application link; I'll submit it as soon as my new licence card arrives.",
      "translation_vi": "Tôi sẽ nhớ. Hãy gửi liên kết đăng ký; tôi nộp ngay khi thẻ giấy phép mới tới.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "transport",
        "registration",
        "insurance",
        "booking_rules",
        "membership_fees"
      ],
      "bank_role": "protected_assessment"
    }
  ],
