  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "The council tested two flood-warning messages with volunteer households.",
      "meaning_vi": "A: Hội đồng thử hai thông báo ngập lụt; thông báo nghe khẩn cấp chưa chắc chỉ rõ hành động.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "One message sounded urgent, but",
      "meaning_vi": "A: Hội đồng thử hai thông báo ngập lụt; thông báo nghe khẩn cấp chưa chắc chỉ rõ hành động.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T03",
      "speaker_id": "C",
      "text_en": "it did not always tell people what action to take.",
      "meaning_vi": "A: Hội đồng thử hai thông báo ngập lụt; thông báo nghe khẩn cấp chưa chắc chỉ rõ hành động.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "The choices participants made in the scenario are our main measure of understanding the warning.",
      "meaning_vi": "B: Lựa chọn hành động trong kịch bản là chỉ số chính.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T05",
      "speaker_id": "C",
      "text_en": "Keep the experience survey, but use it to flag the possibility that prior floods affected people’s decisions.",
      "meaning_vi": "C: Giữ khảo sát kinh nghiệm lũ, ghi chú yếu tố gây nhiễu.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "A warning may appear on a phone screen for only a moment. We should test whether the first sentence remains understandable even when the message preview cuts off the final lines.",
      "meaning_vi": "B: Tin cảnh báo có thể bị cắt trong thông báo điện thoại; câu đầu phải đủ rõ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T07",
      "speaker_id": "B",
      "text_en": "A message that sounds dramatic is not necessarily a message people can act on.",
      "meaning_vi": "B: Thông báo gây ấn tượng mạnh chưa chắc giúp người đọc hành động.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T08",
      "speaker_id": "A",
      "text_en": "The old leaflet provides background on how the council previously communicated risk, not direct evidence about our new messages.",
      "meaning_vi": "A: Tờ rơi cũ chỉ cung cấp bối cảnh lịch sử.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T09",
      "speaker_id": "B",
      "text_en": "Strip full home addresses from the working table before the students receive it. We only need neighbourhood categories.",
      "meaning_vi": "B: Xóa địa chỉ nhà đầy đủ, chỉ giữ nhóm khu vực.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T10",
      "speaker_id": "C",
      "text_en": "We should test the new wording on people unfamiliar with the local river system.",
      "meaning_vi": "C: Nên thử lời mới với người chưa quen hệ thống sông địa phương.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "Ask a qualified translator to check the draft intended for households using the second language. A literal translation may obscure the action.",
      "meaning_vi": "A: Cần người dịch có chuyên môn duyệt bản tin ngôn ngữ thứ hai.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T12",
      "speaker_id": "C",
      "text_en": "Participants remembered the phrase severe flooding, yet several could not say whether to stay indoors or move to higher ground. The message emphasised danger but offered no clear action.",
      "meaning_vi": "C: Thông báo nêu nguy hiểm nhưng thiếu hành động rõ ràng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "The scenario should not encourage volunteers to perform dangerous actions. We can simulate decisions on paper while allowing the local emergency service to approve any real-world advice.",
      "meaning_vi": "A: Tình huống nghiên cứu không được buộc tình nguyện viên làm việc nguy hiểm; lời khuyên thật cần cơ quan khẩn cấp duyệt.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T14",
      "speaker_id": "A",
      "text_en": "We should ask volunteers to choose an action in a realistic simulated situation. Forwarding a message is not evidence that someone knows what to do.",
      "meaning_vi": "A: Đo lựa chọn hành động đúng trong tình huống sơ tán mô phỏng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "The emergency authority must approve any published advice in this project.",
      "meaning_vi": "A: Cơ quan ứng phó khẩn cấp phải duyệt mọi lời khuyên công khai.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "The riverside neighbourhood scored higher, but many households had lived through a flood last year. Their prior experience could explain better decisions, independently of the message design.",
      "meaning_vi": "B: Khu ven sông có kinh nghiệm lũ trước nên điểm cao chưa chắc do mẫu tin.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T17",
      "speaker_id": "C",
      "text_en": "Readers often scan the first line. Put the recommended action there, then the affected area and supporting detail. Do not bury it beneath technical flood terminology.",
      "meaning_vi": "C: Đưa hành động được khuyến nghị lên đầu thông báo.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T18",
      "speaker_id": "C",
      "text_en": "People in the pilot also interpreted the word immediately differently. We should specify an observable action and location rather than rely on urgency words alone.",
      "meaning_vi": "C: Người tham gia hiểu từ ngay lập tức khác nhau; phải nêu hành động và địa điểm cụ thể.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T19",
      "speaker_id": "B",
      "text_en": "I will clearly label all invented scenarios as simulations in the final paper.",
      "meaning_vi": "B: Tôi sẽ ghi rõ các kịch bản tưởng tượng là mô phỏng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T20",
      "speaker_id": "A",
      "text_en": "These were simulated choices, not observed evacuations. We can report comprehension, but we cannot claim to know how people would behave in a real emergency.",
      "meaning_vi": "A: Tình huống mô phỏng đo hiểu biết, không dự đoán chắc hành vi trong khẩn cấp.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T21",
      "speaker_id": "C",
      "text_en": "During the pilot we should also record which parts of each alert participants actually remember a few minutes later. Someone might make a correct choice immediately but forget the location or the action. A short delayed question would reveal whether the warning is clear beyond the first moment.",
      "meaning_vi": "C: Nên kiểm tra phần người tham gia còn nhớ sau vài phút, vì chọn đúng ngay chưa chắc nhớ được nơi và hành động.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "final_critical_discussion"
    },
    {
      "turn_id": "T22",
      "speaker_id": "C",
      "text_en": "Our conclusion will focus on whether people understood the safe action, not on frightening them into clicking a link.",
      "meaning_vi": "C: Nên đánh giá hiểu hành động an toàn thay vì chỉ gây sợ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "conclusion"
    }
  ],
