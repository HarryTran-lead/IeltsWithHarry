    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "We thought the sockets had failed, but the test logs show people unplugged because the instructions were hidden under the armrest. The charging system itself was operating.",
      "meaning_vi": "B: Người dùng dừng sạc vì hướng dẫn khó thấy, không phải cổng hỏng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
