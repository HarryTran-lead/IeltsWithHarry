    },
    {
      "turn_id": "T07",
      "speaker_id": "B",
      "text_en": "We should report battery charge and actual hours of lighting as different variables.",
      "meaning_vi": "B: Phải phân biệt mức pin còn lại với số giờ đèn hoạt động.",
