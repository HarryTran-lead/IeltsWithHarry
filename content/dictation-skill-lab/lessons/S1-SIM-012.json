  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "Hello, Parkside Cycles, this is Ben in the service department. Are you booking a full repair or our quick safety inspection?",
      "translation_vi": "Xin chào Parkside Cycles, tôi là Ben ở bộ phận dịch vụ. Anh muốn sửa toàn bộ hay kiểm tra an toàn nhanh?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "Just a safety inspection, I think. I'm planning a longer cycle ride next month and want to make sure everything is reliable.",
      "translation_vi": "Chắc là kiểm tra an toàn. Tháng sau tôi đạp đường dài và muốn bảo đảm xe hoạt động tốt.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "That's our Road Check service. It includes tyres, brakes and steering, but doesn't automatically include replacing worn components.",
      "translation_vi": "Đó là dịch vụ Road Check. Gồm lốp, phanh và tay lái nhưng không tự động thay linh kiện mòn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "Road Check sounds right. I've had a strange squeak from the rear wheel whenever I slow down on a hill.",
      "translation_vi": "Road Check phù hợp. Bánh sau phát tiếng kêu lạ mỗi khi tôi giảm tốc xuống dốc.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T05",
      "speaker_id": "A",
      "text_en": "That could be the rear brake pads. We'll inspect them, although we can't diagnose the problem properly over the phone.",
      "translation_vi": "Có thể do má phanh sau. Chúng tôi sẽ kiểm tra, dù không thể chẩn đoán chính xác qua điện thoại.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "Fine. What day is your workshop quietest? I have a meeting on Friday afternoon but most other times are flexible.",
      "translation_vi": "Được. Ngày nào xưởng ít bận nhất? Tôi họp chiều thứ Sáu, còn thời gian khác khá linh hoạt.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T07",
      "speaker_id": "A",
      "text_en": "Tuesday morning is usually quieter. Wednesday is devoted to deliveries, and the mechanics are fully booked on Saturday.",
      "translation_vi": "Sáng thứ Ba thường vắng hơn. Thứ Tư nhận hàng, thợ đã kín lịch thứ Bảy.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "Let's go for Tuesday. Could I bring the bike in at around nine, before I start work?",
      "translation_vi": "Vậy thứ Ba. Tôi có thể mang xe lúc khoảng chín giờ, trước khi bắt đầu làm việc không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T09",
      "speaker_id": "A",
      "text_en": "We can offer nine forty. The inspection takes about forty minutes, but you don't need to stay while we work.",
      "translation_vi": "Chúng tôi có giờ chín giờ bốn mươi. Kiểm tra khoảng bốn mươi phút, anh không cần ở lại.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "Nine forty is possible. My bike has an unusual tyre size. Will that make the check slower?",
      "translation_vi": "Chín giờ bốn mươi được. Xe dùng cỡ lốp không thường. Có làm kiểm tra lâu hơn không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "Not for inspection. The tyre pressure is easy to measure. The model you described probably uses twenty-eight-inch wheels, correct?",
      "translation_vi": "Không ảnh hưởng kiểm tra. Áp suất lốp đo dễ. Mẫu anh nói có lẽ dùng bánh hai mươi tám inch, đúng chứ?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T12",
      "speaker_id": "B",
      "text_en": "Yes, twenty-eight inches. The last shop wrote twenty-six on the form, but they were looking at a different bicycle.",
      "translation_vi": "Đúng, hai mươi tám inch. Cửa hàng trước ghi hai mươi sáu do nhìn nhầm xe khác.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "Thanks for confirming. The standard Road Check fee is sixteen pounds, and we'll ask before replacing anything extra.",
      "translation_vi": "Cảm ơn xác nhận. Phí Road Check thường là mười sáu bảng; chúng tôi sẽ hỏi trước khi thay thêm.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T14",
      "speaker_id": "B",
      "text_en": "That's affordable. I might need a new bell too, but I'd like to choose one myself after I know the inspection result.",
      "translation_vi": "Giá ổn. Có thể tôi cần chuông mới, nhưng muốn tự chọn sau khi biết kết quả.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "Of course. Could you tell me the frame colour, so we don't confuse your bike with another one in the rack?",
      "translation_vi": "Tất nhiên. Anh cho màu khung xe để tránh nhầm xe khác trong giá nhé?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "It's dark orange, with a silver bottle holder. Most of the bikes outside your shop seem to be black or blue.",
      "translation_vi": "Khung màu cam đậm, có giá giữ chai bạc. Hầu hết xe ngoài tiệm màu đen hoặc xanh.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "That's distinctive. If a brake cable needs replacement, we can usually finish it the same afternoon, subject to parts being available.",
      "translation_vi": "Dễ nhận biết. Nếu cần thay dây phanh, thường xong chiều hôm đó nếu có linh kiện.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "Good. And if the bike needs major work? I wouldn't want you to start something expensive without checking with me.",
      "translation_vi": "Tốt. Nếu xe cần sửa lớn thì sao? Tôi không muốn anh tự sửa tốn tiền trước khi hỏi.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "Any repair above twenty pounds requires your approval by phone. Otherwise we'll stop and explain the problem before proceeding.",
      "translation_vi": "Bất cứ sửa chữa nào trên hai mươi bảng phải được anh chấp thuận qua điện thoại. Không thì dừng và giải thích trước.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "That helps. Where should I leave the bicycle on arrival? The workshop entrance looks different from the shop's front door.",
      "translation_vi": "Tốt. Tôi để xe ở đâu khi đến? Lối xưởng khác cửa trước cửa hàng.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T21",
      "speaker_id": "A",
      "text_en": "Bring it to the service hatch at the back, next to the bicycle pump. Don't lock it to the fence outside.",
      "translation_vi": "Mang xe đến cửa giao dịch dịch vụ phía sau, cạnh bơm xe. Đừng khóa xe vào hàng rào ngoài.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T22",
      "speaker_id": "B",
      "text_en": "I know the place. I'll be there Tuesday at nine forty and leave the orange bike at the back hatch.",
      "translation_vi": "Tôi biết rồi. Thứ Ba lúc chín giờ bốn mươi tôi sẽ mang xe cam đến cửa sau.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "repair_appointments",
        "technical_terms",
        "costs",
        "safety",
        "collection"
      ],
      "bank_role": "protected_assessment"
    }
  ],
