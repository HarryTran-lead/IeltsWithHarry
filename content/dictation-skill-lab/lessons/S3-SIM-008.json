  ],
  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "We are comparing student feedback before and after the peer-review workshop.",
      "meaning_vi": "A: Nhóm đánh giá phản hồi ngang hàng; lời khen thân thiện chưa chắc có ích.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T02",
      "speaker_id": "C",
      "text_en": "My concern is that students sometimes praise comments that are friendly but not helpful.",
      "meaning_vi": "A: Nhóm đánh giá phản hồi ngang hàng; lời khen thân thiện chưa chắc có ích.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T03",
      "speaker_id": "B",
      "text_en": "Include satisfaction results as context, but do not claim they measure better writing. Enjoyment and achievement are different outcomes.",
      "meaning_vi": "B: Khảo sát hài lòng chỉ làm bối cảnh, không đo cải thiện bài viết.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T04",
      "speaker_id": "A",
      "text_en": "Once names are removed, the revised drafts can become the main evidence of changes in argument quality.",
      "meaning_vi": "A: Bản thảo đã ẩn danh là chứng cứ chính về chất lượng chỉnh sửa.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T05",
      "speaker_id": "A",
      "text_en": "Students may interpret a reviewer’s tone differently from the usefulness of the proposed edit. Our rubric needs to capture whether a comment identifies a problem and suggests an actionable response.",
      "meaning_vi": "A: Rubric phải xét góp ý có nêu vấn đề và hành động sửa được hay không, không chỉ giọng điệu.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T06",
      "speaker_id": "C",
      "text_en": "I had not realised how much a pleasant comment can differ from constructive feedback.",
      "meaning_vi": "C: Lời nhận xét dễ chịu khác với góp ý giúp cải thiện.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T07",
      "speaker_id": "C",
      "text_en": "Keep those first ratings, but explain that friendships may have influenced the judgements. We cannot treat them as blinded scores.",
      "meaning_vi": "C: Giữ điểm đánh giá lời nhận xét với cảnh báo thiên vị bạn bè.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "The first rubric form omitted the category for evidence. We need to pilot a corrected form before using it to score the next set.",
      "meaning_vi": "B: Cần thử lại rubric vì mẫu cũ thiếu tiêu chí chứng cứ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T09",
      "speaker_id": "B",
      "text_en": "We should score the original and revised versions without telling the markers which is which.",
      "meaning_vi": "B: Nên chấm bài gốc và bài sửa mà không cho biết thứ tự.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T10",
      "speaker_id": "A",
      "text_en": "The screenshots contain student names and personal remarks. Remove them from the shared folder until consent and anonymisation have been addressed.",
      "meaning_vi": "A: Loại ảnh chụp tin nhắn riêng chứa danh tính khỏi thư mục dùng chung.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "Platform time tells us about engagement, not learning. Our main outcome should be the quality of revisions students make to their drafts after receiving peer feedback.",
      "meaning_vi": "A: Chỉ số chính là chất lượng chỉnh sửa bài viết sau phản hồi, không phải thời gian dùng nền tảng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T12",
      "speaker_id": "C",
      "text_en": "We should resist turning one sentence of criticism into a single numerical score without keeping the actual revision it prompted. The evidence is in the change to the draft.",
      "meaning_vi": "C: Không nên biến nhận xét thành điểm số mà bỏ qua thay đổi thực tế trong bài viết.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T13",
      "speaker_id": "C",
      "text_en": "The first ratings looked very generous. Then we discovered students knew whose comments they were judging, and several admitted awarding higher marks to their friends.",
      "meaning_vi": "C: Đánh giá ban đầu thiên vị bạn bè vì không ẩn danh.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T14",
      "speaker_id": "A",
      "text_en": "Check that the sample includes students who struggled, not just those who enjoyed the activity.",
      "meaning_vi": "A: Mẫu cần cả sinh viên gặp khó khăn, không chỉ người thích hoạt động.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "We should remove names from the drafts and ask two independent markers to judge the revisions. That would give us evidence beyond the students’ own satisfaction ratings.",
      "meaning_vi": "A: Nên giấu tên bản thảo và nhờ hai người chấm độc lập.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "The most helpful comment was only two sentences, but it identified a missing counterargument and suggested a fix. A long paragraph saying excellent work did not help the writer revise anything.",
      "meaning_vi": "B: Góp ý ngắn nhưng cụ thể có thể hữu ích hơn lời khen dài.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T17",
      "speaker_id": "B",
      "text_en": "I can put the comments and revised paragraphs together for the independent markers, but mask student names and remove the original reviewer identities.",
      "meaning_vi": "B: Có thể ghép góp ý với đoạn sửa để chấm độc lập, đồng thời ẩn danh người học và người nhận xét.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T18",
      "speaker_id": "C",
      "text_en": "I can write up the checklist questions and test whether students interpret them consistently.",
      "meaning_vi": "C: Tôi sẽ thử xem học viên hiểu checklist có thống nhất không.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T19",
      "speaker_id": "C",
      "text_en": "For the next workshop, let each reviewer use a checklist that requires at least one actionable suggestion. We should test whether it changes the revision quality before making it permanent.",
      "meaning_vi": "C: Thử checklist yêu cầu ít nhất một góp ý có thể thực hiện.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "The report can distinguish whether students liked the workshop from whether their revisions actually improved.",
      "meaning_vi": "B: Báo cáo phân biệt mức yêu thích và hiệu quả sửa bài thực tế.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "conclusion"
    }
  ],
