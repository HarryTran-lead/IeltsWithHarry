  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "Lark Meadow Campsite, good evening. Sam speaking. Are you looking for a tent pitch or space for a motorhome?",
      "translation_vi": "Chào tối, Khu cắm trại Lark Meadow, Sam đây. Anh cần chỗ cho lều hay xe nhà lưu động?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "A tent pitch, please. We're bringing two young children, and we'd like electricity because one of our lamps needs charging.",
      "translation_vi": "Chỗ cho lều nhé. Chúng tôi mang hai con nhỏ và cần điện vì một đèn phải sạc.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "Our powered tent area is called Meadow East. The Riverside field has no electricity, although it's nearer to the playground.",
      "translation_vi": "Khu lều có điện tên Meadow East. Bãi Riverside không có điện, dù gần sân chơi hơn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "Meadow East sounds best. We can always walk to the playground, and keeping the lamp working is more important.",
      "translation_vi": "Meadow East phù hợp. Chúng tôi đi bộ tới sân chơi được, và đèn hoạt động quan trọng hơn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T05",
      "speaker_id": "A",
      "text_en": "Which nights were you considering? The bank holiday weekend is filling quickly, so some dates are already unavailable.",
      "translation_vi": "Anh định ở những đêm nào? Cuối tuần lễ đã gần kín nên vài ngày không còn chỗ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "We first planned Friday and Saturday, but my partner can't leave work until Saturday afternoon. Could we stay Saturday and Sunday?",
      "translation_vi": "Chúng tôi ban đầu định tối thứ Sáu và thứ Bảy, nhưng bạn đời phải làm đến chiều thứ Bảy. Có thể ở tối thứ Bảy và Chủ nhật không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T07",
      "speaker_id": "A",
      "text_en": "Yes, Saturday and Sunday are available, with departure on Monday morning. Friday in that area has already been booked.",
      "translation_vi": "Được, còn tối thứ Bảy và Chủ nhật, trả chỗ sáng thứ Hai. Tối thứ Sáu khu đó đã có người đặt.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "Great. What time can we arrive on Saturday? The drive is about two hours and we'll need to stop for food.",
      "translation_vi": "Tốt. Thứ Bảy chúng tôi đến lúc nào? Lái xe khoảng hai tiếng, còn phải dừng ăn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T09",
      "speaker_id": "A",
      "text_en": "Check-in begins at two thirty in the afternoon. If you arrive earlier, you may park outside but not set up the tent.",
      "translation_vi": "Nhận chỗ bắt đầu hai giờ rưỡi chiều. Đến sớm có thể đỗ bên ngoài nhưng chưa dựng lều.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "Two thirty is fine. Does the pitch include an electrical socket, or must we ask for an extra connection?",
      "translation_vi": "Hai rưỡi được. Chỗ có ổ điện sẵn hay cần đăng ký kết nối thêm?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "There is one socket per powered pitch. Please bring a fifteen-metre outdoor cable; ordinary indoor extension leads aren't safe on the grass.",
      "translation_vi": "Có một ổ mỗi chỗ có điện. Hãy mang dây ngoài trời dài mười lăm mét; dây trong nhà không an toàn trên cỏ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T12",
      "speaker_id": "B",
      "text_en": "I'll check our cable length. My tent is quite wide, but it shouldn't take up the entire pitch.",
      "translation_vi": "Tôi sẽ xem chiều dài dây. Lều khá rộng nhưng chắc không chiếm hết chỗ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "Each pitch is eight metres across. We ask campers to keep one metre clear between tents in case staff need access.",
      "translation_vi": "Mỗi chỗ rộng tám mét. Khách cần chừa một mét giữa các lều để nhân viên đi lại.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T14",
      "speaker_id": "B",
      "text_en": "That's enough. What's the nightly charge for two adults and two children on a powered pitch?",
      "translation_vi": "Đủ. Giá mỗi đêm cho hai người lớn hai trẻ với chỗ có điện là bao nhiêu?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "It's thirty-one pounds per night. The unpowered field is twenty-four, but that wouldn't meet your electrical needs.",
      "translation_vi": "Ba mươi mốt bảng mỗi đêm. Bãi không điện hai mươi bốn, nhưng không đáp ứng nhu cầu.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "I'll book two nights. I heard there's a washing block near the eastern field. Does it have a place to wash baby bottles?",
      "translation_vi": "Tôi đặt hai đêm. Tôi nghe khu rửa gần bãi đông. Có chỗ rửa bình sữa không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "The wash block has a separate sink for food utensils, but the hot-water tap closes at ten in the evening to limit noise.",
      "translation_vi": "Khu rửa có bồn riêng cho dụng cụ ăn, nhưng vòi nước nóng đóng lúc mười giờ tối để giảm ồn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "We'll wash bottles before then. Is there a deposit to hold the space? I'd rather not pay the whole amount tonight.",
      "translation_vi": "Chúng tôi sẽ rửa trước giờ đó. Có tiền cọc giữ chỗ không? Tôi chưa muốn trả hết tối nay.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "A fifteen-pound deposit secures the booking. The remainder is due on arrival, and you can pay by card at reception.",
      "translation_vi": "Đặt cọc mười lăm bảng giữ chỗ. Phần còn lại trả khi đến, có thể thanh toán thẻ tại quầy.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "That works. Is the campsite still allowing campfires? The children would love to toast marshmallows after dinner.",
      "translation_vi": "Được. Khu cắm trại còn cho đốt lửa không? Trẻ muốn nướng kẹo sau bữa tối.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T21",
      "speaker_id": "A",
      "text_en": "Open campfires are prohibited this season. You may use a raised camping stove, provided it stays well clear of the tent fabric.",
      "translation_vi": "Mùa này cấm lửa trại ngoài trời. Được dùng bếp cắm trại nâng cao nếu cách xa vải lều.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T22",
      "speaker_id": "B",
      "text_en": "Understood. Please reserve Meadow East for Saturday and Sunday; we'll bring the outdoor cable and a safe camping stove.",
      "translation_vi": "Hiểu rồi. Hãy đặt Meadow East tối thứ Bảy và Chủ nhật; chúng tôi mang dây ngoài trời và bếp an toàn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "accommodation",
        "electricity",
        "dates",
        "facilities",
        "deposit"
      ],
      "bank_role": "protected_assessment"
    }
  ],
