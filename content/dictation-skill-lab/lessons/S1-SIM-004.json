  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "Hello, Northside Repair Café. Malik speaking. We help people fix household items rather than throwing them away. What have you got?",
      "translation_vi": "Xin chào, Quán sửa chữa cộng đồng Northside, Malik nghe. Chúng tôi giúp sửa đồ gia dụng thay vì vứt đi. Anh có món gì?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "An old table lamp. The light flickers even with a new bulb, and I'd rather repair it than buy another one.",
      "translation_vi": "Một đèn bàn cũ. Đèn nhấp nháy ngay cả khi thay bóng mới, tôi muốn sửa hơn mua cái khác.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "That sounds like a possible wiring problem. We can inspect lamps, but we don't repair microwave ovens because of the electrical risk.",
      "translation_vi": "Có thể là dây điện. Chúng tôi kiểm tra đèn, nhưng không sửa lò vi sóng vì nguy hiểm điện.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "It's definitely just a lamp. Do I need to book, or can I turn up at the community hall with it?",
      "translation_vi": "Đúng là đèn bàn. Tôi có cần đặt lịch hay cứ đến hội trường cộng đồng mang theo?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T05",
      "speaker_id": "A",
      "text_en": "We ask people to book a slot. The next repair café is held on the second Saturday of the month, rather than every weekend.",
      "translation_vi": "Chúng tôi yêu cầu đặt lịch. Quán sửa chữa tiếp theo vào thứ Bảy thứ hai trong tháng, không phải cuối tuần nào cũng có.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "I thought it was on Friday. That's useful. Is there a morning slot after ten? I have to take my daughter to swimming first.",
      "translation_vi": "Tôi tưởng thứ Sáu. Tốt quá. Có giờ sáng sau mười giờ không? Tôi phải đưa con gái đi bơi trước.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T07",
      "speaker_id": "A",
      "text_en": "We have a slot at ten forty. There's one at nine twenty, but I can see why that would be too early for you.",
      "translation_vi": "Có khung mười giờ bốn mươi. Có một khung chín giờ hai mươi nhưng có lẽ quá sớm cho anh.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "Ten forty, please. Should I bring only the lamp, or do volunteers prefer the original power cable as well?",
      "translation_vi": "Mười giờ bốn mươi nhé. Tôi chỉ đem đèn hay tình nguyện viên muốn cả dây nguồn gốc?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T09",
      "speaker_id": "A",
      "text_en": "Please bring the power cable. Even if the bulb is fine, testing the entire connection is essential before we decide what to fix.",
      "translation_vi": "Hãy mang dây nguồn. Dù bóng tốt, phải thử toàn bộ kết nối trước khi quyết định sửa gì.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "All right. There's also a cracked lampshade, but that's cosmetic and can wait until the wiring is safe.",
      "translation_vi": "Được. Chụp đèn cũng nứt nhưng chỉ liên quan bề ngoài, để sau khi dây an toàn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "Our inspection is free. If a replacement component is needed, you pay only for the part, not the volunteer's time.",
      "translation_vi": "Kiểm tra miễn phí. Nếu cần thay linh kiện, anh chỉ trả tiền linh kiện chứ không trả công tình nguyện viên.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T12",
      "speaker_id": "B",
      "text_en": "That seems fair. What's the expected cost of a new switch? I'd rather know before agreeing to any parts.",
      "translation_vi": "Công bằng. Công tắc mới dự kiến giá bao nhiêu? Tôi muốn biết trước khi đồng ý thay gì.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "A basic switch is around seven pounds. We don't guarantee a repair, though, and volunteers will discuss the cost before fitting anything.",
      "translation_vi": "Công tắc cơ bản khoảng bảy bảng. Chúng tôi không bảo đảm sửa được và sẽ trao đổi chi phí trước khi lắp.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T14",
      "speaker_id": "B",
      "text_en": "Great. My name is Callum Reid, R E I D. Do you also need the make of the lamp for your records?",
      "translation_vi": "Tốt. Tôi là Callum Reid, R E I D. Anh có cần hãng đèn để ghi hồ sơ không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "Yes, if you know it. We'll create a note on our booking sheet so the right volunteer can prepare some suitable tools.",
      "translation_vi": "Có nếu anh biết. Chúng tôi ghi vào phiếu đặt lịch để tình nguyện viên phù hợp chuẩn bị dụng cụ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "There's no brand label, but it has a ceramic base and a green shade. The plug is a standard three-pin model.",
      "translation_vi": "Không có nhãn hãng, nhưng đế gốm và chụp xanh lá. Phích là loại ba chấu thường.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "That's enough description. During your appointment we ask you to stay at the workbench; we can't take appliances away for repairs.",
      "translation_vi": "Mô tả thế là đủ. Khi đến, anh phải ở lại bàn sửa; chúng tôi không nhận mang đồ đi sửa nơi khác.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "I was planning to leave it and collect it later. But I can stay for half an hour while someone looks at the connection.",
      "translation_vi": "Tôi định để lại rồi nhận sau. Nhưng tôi có thể ở lại nửa giờ để kiểm tra kết nối.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "If the lamp needs a more complicated repair, we'll explain how to find a qualified electrician instead of attempting unsafe work.",
      "translation_vi": "Nếu đèn cần sửa phức tạp, chúng tôi sẽ chỉ cách tìm thợ điện đủ chuyên môn thay vì làm việc không an toàn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "Good. Where do I enter the building? The main door usually faces the park, but that side has building works.",
      "translation_vi": "Tốt. Tôi vào tòa nhà ở đâu? Cửa chính hướng công viên, nhưng phía đó đang thi công.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T21",
      "speaker_id": "A",
      "text_en": "Use the side entrance on Garden Street. It's wheelchair accessible and there's a sign for the repair café beside the ramp.",
      "translation_vi": "Hãy dùng cửa bên trên Garden Street. Có đường xe lăn và biển quán sửa cạnh dốc.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T22",
      "speaker_id": "B",
      "text_en": "I'll come through Garden Street with the lamp and its cable. Thank you for helping me keep it out of the bin.",
      "translation_vi": "Tôi sẽ tới qua Garden Street, đem đèn và dây. Cảm ơn đã giúp tôi tránh vứt nó đi.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "device_repairs",
        "fees",
        "dates",
        "conditions"
      ],
      "bank_role": "protected_assessment"
    }
  ],
