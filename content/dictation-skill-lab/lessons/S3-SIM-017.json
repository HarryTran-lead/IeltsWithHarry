  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "We are evaluating communication for a campus wellbeing campaign, not diagnosing individual students.",
      "meaning_vi": "A: Đánh giá cách truyền thông chiến dịch sức khỏe tinh thần, không chẩn đoán cá nhân.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T02",
      "speaker_id": "C",
      "text_en": "The organisers reported high website traffic, but B found that most visitors stayed only briefly.",
      "meaning_vi": "A: Đánh giá cách truyền thông chiến dịch sức khỏe tinh thần, không chẩn đoán cá nhân.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T03",
      "speaker_id": "B",
      "text_en": "The campaign celebrated ten thousand page visits, but that does not tell us if students located the right support contact or understood what to do next.",
      "meaning_vi": "B: Lượt truy cập không chứng minh người xem tìm được thông tin hỗ trợ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T04",
      "speaker_id": "A",
      "text_en": "Ask participants to find an appropriate support service for a fictional scenario. That tests the clarity of the information without asking them to reveal personal experiences.",
      "meaning_vi": "A: Cho tình huống giả định và kiểm tra người dùng tìm đúng dịch vụ hỗ trợ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T05",
      "speaker_id": "C",
      "text_en": "Some participants took several attempts to find the correct service, even though they eventually got there. We should record the navigation path as well as the final answer.",
      "meaning_vi": "C: Nên ghi đường đi tìm hỗ trợ và số lần thử, không chỉ kết quả cuối.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T06",
      "speaker_id": "C",
      "text_en": "I will use neutral scenarios so no one feels obliged to share something personal.",
      "meaning_vi": "C: Tôi sẽ dùng kịch bản trung tính để không ai phải kể chuyện riêng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T07",
      "speaker_id": "C",
      "text_en": "Our draft asked students to describe their worst experiences on campus. That is unnecessary and intrusive for a navigation study. We should ask about using the information, not about personal histories.",
      "meaning_vi": "C: Câu hỏi cũ xâm phạm đời tư; nên hỏi cách tìm thông tin.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "Several students thought the routine appointment email was the emergency contact. That is more serious than a layout preference, and the labels must be revised first.",
      "meaning_vi": "B: Sinh viên nhầm liên hệ thông thường với liên hệ khẩn cấp.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T09",
      "speaker_id": "B",
      "text_en": "We also need to distinguish a wrong answer from a situation in which the website itself offered two conflicting links.",
      "meaning_vi": "B: Cần phân biệt trả lời sai với trường hợp website đưa hai liên kết mâu thuẫn.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T10",
      "speaker_id": "A",
      "text_en": "We should create a clearly marked route for urgent help, separate from routine enquiries. Buying more advertisements before fixing that confusion would only spread the problem.",
      "meaning_vi": "A: Ưu tiên phân biệt rõ hỗ trợ khẩn cấp và không khẩn cấp.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T11",
      "speaker_id": "C",
      "text_en": "The click totals can provide background about reach, but they are not an outcome measure of successful navigation.",
      "meaning_vi": "C: Số lượt nhấp chỉ phản ánh mức tiếp cận, không đo khả năng tìm đúng hỗ trợ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T12",
      "speaker_id": "A",
      "text_en": "The research team cannot provide clinical advice. If a genuine concern arises, the approved referral route should be available immediately, and research questions should stop.",
      "meaning_vi": "A: Nhóm nghiên cứu không tư vấn lâm sàng; khi có lo ngại thật phải chuyển tới nơi hỗ trợ theo quy trình.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "The scenario responses give us a direct, privacy-preserving measure of whether people can identify the right service.",
      "meaning_vi": "A: Đáp án tình huống giả định là chỉ số chính về tìm đúng dịch vụ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T14",
      "speaker_id": "A",
      "text_en": "If a participant needs genuine help, the researcher should have a safe referral procedure ready.",
      "meaning_vi": "A: Người nghiên cứu cần quy trình giới thiệu nơi hỗ trợ nếu ai đó thực sự cần.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T15",
      "speaker_id": "B",
      "text_en": "Remove the questions asking for personal distressing experiences. They are not necessary for evaluating the campaign.",
      "meaning_vi": "B: Loại câu hỏi yêu cầu trải nghiệm riêng tư gây khó chịu.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T16",
      "speaker_id": "C",
      "text_en": "We can retain the pilot navigation logs, but mark that the menu changed after the first three participants.",
      "meaning_vi": "C: Giữ nhật ký điều hướng và ghi chú menu đã thay đổi.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T17",
      "speaker_id": "B",
      "text_en": "A clearer emergency link would help students with limited language proficiency too. In the next pilot, we should test the wording with people who have different first languages.",
      "meaning_vi": "B: Liên kết khẩn cấp rõ ràng cũng hỗ trợ người có ngôn ngữ mẹ đẻ khác; cần thử với họ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T18",
      "speaker_id": "C",
      "text_en": "That protects participants while keeping our research question focused.",
      "meaning_vi": "C: Cách này bảo vệ người tham gia và giữ trọng tâm nghiên cứu.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "The enquiries contain names and personal details. Keep them restricted and do not export them into the research spreadsheet.",
      "meaning_vi": "A: Dữ liệu yêu cầu hỗ trợ có định danh phải hạn chế truy cập.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "We should test both versions of the message with someone who has not visited the campaign site before. A regular user may know the right support contact from memory and hide a navigation problem. The first-time test will make unclear labels much more obvious.",
      "meaning_vi": "B: Cần thử với người chưa từng vào trang chiến dịch; người dùng quen có thể nhớ liên hệ và che giấu lỗi điều hướng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "final_critical_discussion"
    },
    {
      "turn_id": "T21",
      "speaker_id": "B",
      "text_en": "Our recommendation should focus on whether students found clear routes to support, without collecting private medical details.",
      "meaning_vi": "B: Đề xuất cần xem sinh viên có tìm được nguồn hỗ trợ rõ ràng không, không lấy thông tin y tế riêng.",
