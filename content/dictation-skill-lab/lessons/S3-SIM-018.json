  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "B",
      "text_en": "We mounted three inexpensive air sensors near the campus gates.",
      "meaning_vi": "B: Ba cảm biến không khí rẻ tiền cho số liệu khác nhau gần cổng trường; cần tách nguyên nhân kỹ thuật.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T02",
      "speaker_id": "C",
      "text_en": "Their readings disagree, especially during the morning traffic peak.",
      "meaning_vi": "B: Ba cảm biến không khí rẻ tiền cho số liệu khác nhau gần cổng trường; cần tách nguyên nhân kỹ thuật.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "We need to understand whether that difference is environmental or technical.",
      "meaning_vi": "B: Ba cảm biến không khí rẻ tiền cho số liệu khác nhau gần cổng trường; cần tách nguyên nhân kỹ thuật.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "The calibrated municipal readings will be the baseline against which we judge the inexpensive sensors.",
      "meaning_vi": "B: Số liệu trạm đô thị đã hiệu chuẩn là chuẩn so sánh chính.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T05",
      "speaker_id": "C",
      "text_en": "Keep the humidity-related spikes with a warning about the instrument response; do not silently smooth them away.",
      "meaning_vi": "C: Giữ các đỉnh số liệu và cảnh báo ảnh hưởng độ ẩm.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T06",
      "speaker_id": "C",
      "text_en": "The sensors have different response times. A rapid pollution spike may appear at slightly different moments even if two devices are side by side, so timing has to be aligned first.",
      "meaning_vi": "C: Cảm biến có độ trễ khác nhau, cần căn thời gian trước khi so các đỉnh ô nhiễm.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T07",
      "speaker_id": "A",
      "text_en": "A high correlation would still not prove that absolute values are accurate.",
      "meaning_vi": "A: Tương quan cao vẫn không chứng minh giá trị tuyệt đối chính xác.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T08",
      "speaker_id": "A",
      "text_en": "Use the brochure to describe the measurement principle, not as evidence that the devices performed well at our site.",
      "meaning_vi": "A: Tài liệu hãng chỉ làm nền về cơ chế đo.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T09",
      "speaker_id": "B",
      "text_en": "The inlet on one unit was blocked by grit. We need to clean the device and repeat that section of the comparison.",
      "meaning_vi": "B: Cần sửa cảm biến có cửa hút bị tắc và đo lại.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "We can plot the difference from the reference at each reading rather than only averages.",
      "meaning_vi": "B: Có thể vẽ mức lệch so với trạm chuẩn ở từng lần đo.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T11",
      "speaker_id": "C",
      "text_en": "Before using the installation photographs, blur any students who can be identified near the gates.",
      "meaning_vi": "C: Làm mờ học sinh nhận diện được trong ảnh lắp đặt.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T12",
      "speaker_id": "C",
      "text_en": "One sensor was near exhaust level and another sat high above the wall. They were exposed to different air streams, so the comparison was not a fair test of device agreement.",
      "meaning_vi": "C: Cảm biến đặt ở độ cao khác nhau khiến việc so sánh thiếu công bằng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T13",
      "speaker_id": "B",
      "text_en": "I almost removed the high-humidity samples as outliers. Instead, we should retain them with a note and test whether a correction method works under wet conditions.",
      "meaning_vi": "B: Không nên loại mẫu ẩm cao chỉ vì lệch; nên giữ và thử hiệu chỉnh.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T14",
      "speaker_id": "A",
      "text_en": "Compare the low-cost units with readings from the calibrated municipal station. It is not perfect for every street, but it provides a defensible reference for checking systematic error.",
      "meaning_vi": "A: Dùng trạm quan trắc đô thị đã hiệu chuẩn làm mốc.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T15",
      "speaker_id": "C",
      "text_en": "I will also record whether roadworks were happening during a measurement.",
      "meaning_vi": "C: Tôi sẽ ghi nhận có công trình đường bộ khi đo không.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "We interpreted the spike as traffic pollution. Later we found that high humidity can affect this model’s optical measurement, so part of the rise may be an artefact.",
      "meaning_vi": "B: Độ ẩm cao có thể làm sai số của cảm biến quang học.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T17",
      "speaker_id": "C",
      "text_en": "For the next stage, we will colocate the three units beside the reference station for several days before distributing them across the campus.",
      "meaning_vi": "C: Đặt ba thiết bị cạnh trạm chuẩn vài ngày trước khi phân tán.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T18",
      "speaker_id": "A",
      "text_en": "Make the units explicit on every graph. A numerical agreement is meaningless if one data series has been converted and the other still uses the raw manufacturer scale.",
      "meaning_vi": "A: Phải ghi đơn vị rõ trên mọi biểu đồ; không thể so chuỗi đã đổi đơn vị với chuỗi thô.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "Describe both uncertainty and practical value in the final summary.",
      "meaning_vi": "A: Tóm tắt cuối cần nêu cả độ bất định và giá trị thực tế.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T20",
      "speaker_id": "A",
      "text_en": "Our brief trial may show whether the sensors follow short-term changes. It cannot measure every student’s personal exposure or replace a full-year city monitoring programme.",
      "meaning_vi": "A: Nghiên cứu nhỏ chỉ kiểm tra khả năng theo dõi biến động ngắn hạn.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T21",
      "speaker_id": "C",
      "text_en": "I also want to report how many readings each sensor produces when conditions are damp, not just the average of the values it successfully returned. If one device misses the most difficult periods, it may appear unusually accurate only because the challenging observations are absent.",
      "meaning_vi": "C: Nên báo cả số lần cảm biến bỏ lỡ số đo trong điều kiện ẩm; nếu chỉ lấy kết quả có được sẽ tưởng máy chính xác hơn.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "final_critical_discussion"
    },
    {
      "turn_id": "T22",
      "speaker_id": "C",
      "text_en": "Our graph can show how well the low-cost sensors track changes, without claiming laboratory precision they do not have.",
      "meaning_vi": "C: Biểu đồ chỉ nên cho thấy xu hướng, không khẳng định độ chính xác như phòng thí nghiệm.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "conclusion"
    }
