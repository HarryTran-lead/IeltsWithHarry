  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "Your project compares standard labels with interactive displays in the archaeology gallery.",
      "meaning_vi": "A: Nghiên cứu so nhãn thông thường và màn hình tương tác; nhiều gia đình tham quan cùng nhau.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "We collected questionnaires, but C noticed that families often explored the room together.",
      "meaning_vi": "A: Nghiên cứu so nhãn thông thường và màn hình tương tác; nhiều gia đình tham quan cùng nhau.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T03",
      "speaker_id": "C",
      "text_en": "Our first graph suggested interactive labels were better because visitors stayed longer. But some stayed because the navigation was confusing, not because they understood the artefact.",
      "meaning_vi": "C: Thời gian lâu có thể do giao diện khó hiểu, không phải học tốt.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T04",
      "speaker_id": "A",
      "text_en": "Instead of counting touches, ask visitors to explain one object in their own words after leaving the display, then assess the explanation against a clear rubric.",
      "meaning_vi": "A: Đo chất lượng giải thích hiện vật sau xem bằng rubric.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T05",
      "speaker_id": "C",
      "text_en": "Several visitors abandoned the touchscreen when a video started automatically. That behaviour may be a usability problem, not evidence that archaeology itself failed to interest them.",
      "meaning_vi": "C: Khách bỏ màn hình khi video tự chạy có thể do giao diện kém chứ không phải chán khảo cổ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "The distinction between entertainment and explanation is central to this project.",
      "meaning_vi": "B: Phải phân biệt giải trí và giải thích kiến thức.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T07",
      "speaker_id": "B",
      "text_en": "In several families, one adult answered the questions for everyone. Treating those responses as independent individual learning scores would be misleading.",
      "meaning_vi": "B: Một người trong gia đình có thể trả lời thay cả nhóm, gây sai lệch dữ liệu.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T08",
      "speaker_id": "C",
      "text_en": "Many visitors could not find their way back after opening a video. We should add a prominent return-to-menu control before testing the displays again.",
      "meaning_vi": "C: Cần thêm nút về menu chính dễ thấy vì người dùng bị lạc.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T09",
      "speaker_id": "C",
      "text_en": "The design team needs specific examples of confusing navigation, not just a low score.",
      "meaning_vi": "C: Nhóm thiết kế cần ví dụ cụ thể về điều hướng khó hiểu.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T10",
      "speaker_id": "A",
      "text_en": "The results may show a benefit for particular objects with clear navigation, not a universal advantage for every interactive exhibit.",
      "meaning_vi": "A: Chỉ nên kết luận một số nhãn tương tác có ích trong điều kiện cụ thể.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T11",
      "speaker_id": "B",
      "text_en": "Keep the dwell-time records but warn that time may reflect confusion as well as engagement.",
      "meaning_vi": "B: Giữ số liệu thời gian xem với cảnh báo có thể do bối rối.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T12",
      "speaker_id": "A",
      "text_en": "We should give visitors the same amount of time to explain the object after either type of label. Otherwise the assessment conditions themselves could influence the quality of the answer.",
      "meaning_vi": "A: Phải cho khách cùng lượng thời gian giải thích hiện vật sau hai dạng nhãn.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "Use the object explanations scored with the revised rubric as the principal evidence of learning.",
      "meaning_vi": "A: Phần trả lời giải thích hiện vật được chấm bằng rubric mới là chỉ số chính.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T14",
      "speaker_id": "A",
      "text_en": "Make the questions comprehensible to visitors without specialist archaeological vocabulary.",
      "meaning_vi": "A: Câu hỏi phải dễ hiểu với khách không biết thuật ngữ khảo cổ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T15",
      "speaker_id": "C",
      "text_en": "The screenshots can show the old interface to readers, though they cannot measure whether visitors learned anything.",
      "meaning_vi": "C: Ảnh màn hình giao diện cũ chỉ để minh họa.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "We should label responses from whole families differently and avoid linking a child’s answer to any identifiable adult.",
      "meaning_vi": "B: Phân loại đáp án gia đình và bỏ liên kết định danh người lớn/trẻ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T17",
      "speaker_id": "B",
      "text_en": "In the presentation, I will separate observations from interpretations: what visitors clicked is a recorded action, but why they clicked still requires a cautious inference.",
      "meaning_vi": "B: Cần tách hành động bấm thực tế khỏi suy đoán lý do họ bấm.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "I can score a small sample independently to see whether the rubric produces consistent judgements.",
      "meaning_vi": "B: Tôi có thể chấm độc lập mẫu nhỏ để kiểm tra độ thống nhất rubric.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "Our first rubric used vague labels like good understanding. Rewrite and pilot it with two observers to check agreement.",
      "meaning_vi": "A: Viết lại rubric mơ hồ và thử với hai người quan sát.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T20",
      "speaker_id": "C",
      "text_en": "I think the revised design gives us a much clearer question for the second visitor trial. We are not asking which display people find most entertaining; we are asking whether they can explain a real object afterwards. If that difference stays visible in our report, the museum team can act on the findings.",
      "meaning_vi": "C: Lần thử hai cần đo khách giải thích hiện vật thế nào chứ không chỉ thích màn hình nào; như vậy bảo tàng mới dùng được kết quả.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "final_critical_discussion"
    },
    {
      "turn_id": "T21",
      "speaker_id": "C",
      "text_en": "We can describe which labels led visitors to explain artefacts more accurately without assuming that every touchscreen is automatically educational.",
      "meaning_vi": "C: Đánh giá hiểu hiện vật, không giả định màn hình cảm ứng luôn tốt.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
