      "turn_id": "T01",
      "speaker_id": "C",
      "text_en": "Our initial map linked three woodland patches.",
      "meaning_vi": "C: Bản đồ kết nối ba mảng rừng ban đầu đẹp mắt nhưng cần đối chiếu quan sát thực địa.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
