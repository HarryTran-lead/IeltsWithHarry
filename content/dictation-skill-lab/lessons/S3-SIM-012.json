    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "It looked convincing until we compared it with field observations.",
      "meaning_vi": "C: Bản đồ kết nối ba mảng rừng ban đầu đẹp mắt nhưng cần đối chiếu quan sát thực địa.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "Let us decide which proposed connections are genuinely supported.",
      "meaning_vi": "C: Bản đồ kết nối ba mảng rừng ban đầu đẹp mắt nhưng cần đối chiếu quan sát thực địa.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T04",
      "speaker_id": "C",
      "text_en": "Keep the blocked-camera records, but mark those nights as unreliable rather than interpreting the zeros as absence.",
      "meaning_vi": "C: Giữ dữ liệu camera bị che nhưng đánh dấu đêm không đáng tin.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T05",
      "speaker_id": "B",
      "text_en": "The crossing photographs are the strongest independent evidence for the proposed passage location.",
      "meaning_vi": "B: Ảnh động vật đi qua cống là chứng cứ chính.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "The field notes show animal footprints near a hedge, but a footprint alone cannot tell us whether the whole stretch is regularly used as a corridor. We need repeated observations.",
      "meaning_vi": "B: Dấu chân gần hàng rào chưa chứng minh cả tuyến thường được động vật sử dụng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T07",
      "speaker_id": "C",
      "text_en": "A missing observation is very different from an observation showing absence.",
      "meaning_vi": "C: Không quan sát thấy khác với quan sát thấy không tồn tại.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T08",
      "speaker_id": "A",
      "text_en": "An aerial tourism map helps orient readers, although it was made for visitors and cannot measure habitat quality.",
      "meaning_vi": "A: Bản đồ du lịch trên không chỉ hỗ trợ định hướng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T09",
      "speaker_id": "C",
      "text_en": "The interview notes contain full names and addresses. Prepare an anonymous summary for the public report.",
      "meaning_vi": "C: Tóm tắt ẩn danh ghi chép phỏng vấn chủ đất.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "I will distinguish private land from public right-of-way on the draft map.",
      "meaning_vi": "B: Tôi sẽ tách đất tư và đường công cộng trên bản đồ.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "The species list is almost ten years old. It is worth repeating the survey rather than assuming the same communities remain.",
      "meaning_vi": "A: Danh mục loài đã cũ, cần khảo sát lại.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T12",
      "speaker_id": "A",
      "text_en": "The straight route looks efficient on screen, but it crosses a busy road where we found no safe animal passage. Distance alone cannot determine a functional corridor.",
      "meaning_vi": "A: Tuyến thẳng băng qua đường đông xe mà không có lối qua an toàn.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "Your map should distinguish the physical possibility of movement from evidence of actual movement. They are related questions, but planning decisions can go wrong if they are treated as identical.",
      "meaning_vi": "A: Phân biệt nơi có thể di chuyển và nơi đã có bằng chứng động vật đi qua.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T14",
      "speaker_id": "B",
      "text_en": "The camera records show crossings near the old culvert. Combine those with the woodland cover rather than with tourist paths or the apparent straight-line distance.",
      "meaning_vi": "B: Dùng điểm động vật qua đường và độ che phủ sinh cảnh để chọn tuyến.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "Give the model a range of plausible routes instead of one solid coloured line.",
      "meaning_vi": "A: Mô hình nên trình bày một số tuyến khả thi thay vì một đường chắc chắn.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T16",
      "speaker_id": "C",
      "text_en": "We assumed the southern site had no activity. In fact weeds blocked the camera’s field of view for several nights, so a zero count there cannot be trusted.",
      "meaning_vi": "C: Camera phía nam bị cây che tầm nhìn nên số 0 chưa đáng tin.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "A shaded corridor on a map can imply changes to privately managed land. Speak to the landowners before publicly suggesting a route across their properties.",
      "meaning_vi": "A: Cần trao đổi với chủ đất trước khi công bố tuyến đi qua đất tư.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T18",
      "speaker_id": "C",
      "text_en": "In the next field trip we can note vegetation gaps and barriers on the ground, then compare those observations with the boundaries produced by our computer model.",
      "meaning_vi": "C: Lần khảo sát tới sẽ ghi khe hở cây và rào chắn để đối chiếu với mô hình máy tính.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T19",
      "speaker_id": "C",
      "text_en": "I will list the assumptions beside the GIS output so another team can test them.",
      "meaning_vi": "C: Tôi sẽ liệt kê giả định bên cạnh kết quả GIS.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "We have only distant images of the culvert. A careful daylight survey can establish whether its entrance is passable, without disturbing wildlife at night.",
      "meaning_vi": "B: Ưu tiên khảo sát cống cũ ban ngày để xem có thể đi qua hay không.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T21",
      "speaker_id": "A",
      "text_en": "Please make the limits of the spatial model visible in the final map legend. An apparently continuous green band may contain a fence, an exposed crossing or private land. If readers cannot see those obstacles, the map could encourage interventions that are ecologically ineffective and socially unacceptable.",
      "meaning_vi": "A: Chú giải bản đồ phải thể hiện rào chắn, đường trống và đất tư; một dải xanh liền không chứng minh động vật đi được.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "final_critical_discussion"
    },
    {
      "turn_id": "T22",
      "speaker_id": "B",
      "text_en": "We can offer a transparent planning map with areas of uncertainty, not a promise that animals will use every proposed path.",
      "meaning_vi": "B: Chỉ nên đề xuất bản đồ quy hoạch có ghi vùng bất định.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
