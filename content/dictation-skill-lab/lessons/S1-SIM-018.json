  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "Hello, Harbour Arts Festival volunteers' office. This is Chloe. Are you interested in helping during the event itself?",
      "translation_vi": "Xin chào văn phòng tình nguyện Lễ hội Nghệ thuật Harbour, Chloe đây. Anh muốn giúp trong lễ hội phải không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "Yes. I came as a visitor last year and enjoyed the performances, so I'd like to contribute a few hours this time.",
      "translation_vi": "Vâng. Năm ngoái tôi đến xem và thích các buổi biểu diễn, năm nay muốn hỗ trợ vài giờ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "We currently need volunteers for our Welcome Team. The backstage crew is full, and ticket sales are handled by paid staff.",
      "translation_vi": "Chúng tôi cần tình nguyện viên đội Welcome Team. Hậu trường đã đủ, bán vé do nhân viên trả lương lo.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "Welcome Team would suit me. I work with customers every day, and I enjoy helping people find their way around.",
      "translation_vi": "Welcome Team hợp với tôi. Tôi làm việc với khách mỗi ngày, thích giúp mọi người tìm đường.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T05",
      "speaker_id": "A",
      "text_en": "Visitors often arrive with questions about accessible entrances, so a calm manner is useful when several events begin close together.",
      "translation_vi": "Khách thường hỏi lối vào thuận tiện, nên thái độ bình tĩnh hữu ích khi nhiều sự kiện gần giờ bắt đầu.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "I deal with queues at work, so I shouldn't be too worried by crowds. I'd rather be near the public entrances anyway.",
      "translation_vi": "Ở chỗ làm tôi quen xử lý hàng chờ nên không sợ đông. Tôi cũng thích làm gần lối vào chung.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T07",
      "speaker_id": "A",
      "text_en": "Excellent. The main festival is in July, but all volunteers attend an orientation session during the previous week.",
      "translation_vi": "Tốt. Lễ hội chính vào tháng Bảy, nhưng tình nguyện viên cần dự hướng dẫn tuần trước đó.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "I was hoping to join the Thursday briefing. Is that available, or does everyone have to attend on the same day?",
      "translation_vi": "Tôi muốn dự buổi hướng dẫn thứ Năm. Còn không hay mọi người phải cùng ngày?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T09",
      "speaker_id": "A",
      "text_en": "The Thursday briefing is for performers. Volunteers are booked for Wednesday evening, with a shorter repeat session on Friday morning.",
      "translation_vi": "Thứ Năm dành cho nghệ sĩ. Tình nguyện viên học tối thứ Tư, có buổi ngắn lặp lại sáng thứ Sáu.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "Wednesday evening is fine. Is it at the main theatre, where the opening concert takes place?",
      "translation_vi": "Tối thứ Tư được. Có học ở nhà hát chính, nơi có hòa nhạc mở màn không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "No, the orientation is in the gallery studio on the first floor of the arts centre. It's a quieter room for demonstrations.",
      "translation_vi": "Không, hướng dẫn tại phòng studio triển lãm tầng một của trung tâm nghệ thuật, yên tĩnh để trình diễn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T12",
      "speaker_id": "B",
      "text_en": "I can find that. How long will orientation take? I have another commitment later that evening.",
      "translation_vi": "Tôi đến được. Buổi hướng dẫn dài bao lâu? Tối đó tôi còn việc.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "It lasts ninety minutes. We finish with a short walk through the public entrances so everyone knows the emergency exits.",
      "translation_vi": "Buổi hướng dẫn chín mươi phút. Cuối buổi đi quanh lối vào công chúng để biết cửa thoát hiểm.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T14",
      "speaker_id": "B",
      "text_en": "That sounds useful. I can work on the Saturday, but not Sunday. What shifts are still available?",
      "translation_vi": "Hữu ích đấy. Tôi làm được thứ Bảy nhưng không Chủ nhật. Còn ca nào?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "We have an afternoon shift from one to five. The morning shift starts at eight, but it's already fully staffed.",
      "translation_vi": "Còn ca chiều từ một đến năm giờ. Ca sáng bắt đầu lúc tám nhưng đã đủ người.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "I'll take the afternoon shift. Does everyone receive the same festival shirt, or do volunteers bring their own clothes?",
      "translation_vi": "Tôi chọn ca chiều. Mọi người có áo lễ hội hay tự mang quần áo?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "We'll provide a yellow vest that says Volunteer. Please wear comfortable dark trousers and closed shoes of your own.",
      "translation_vi": "Chúng tôi cấp áo ghi-lê vàng có chữ Volunteer. Anh tự mặc quần tối màu và giày kín mũi thoải mái.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "I already have suitable shoes. Should I bring food? Working four hours around a busy event can make me hungry.",
      "translation_vi": "Tôi có giày phù hợp. Có nên mang đồ ăn không? Làm bốn giờ ở nơi đông dễ đói.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "A water bottle is essential, but light snacks are provided at the volunteer desk. We can't guarantee a full meal on shift.",
      "translation_vi": "Cần mang chai nước, còn đồ ăn nhẹ được cung cấp ở bàn tình nguyện. Không bảo đảm suất ăn đầy đủ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "I'll bring my bottle. Will I be dealing with cash or ticket scanners during the event?",
      "translation_vi": "Tôi mang chai. Tôi có phải nhận tiền hay quét vé không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T21",
      "speaker_id": "A",
      "text_en": "Welcome Team members direct visitors and answer accessibility questions. Only trained box-office staff handle payments and scanners.",
      "translation_vi": "Đội Welcome Team chỉ đường và trả lời về tiếp cận. Chỉ nhân viên quầy vé đã đào tạo xử lý thanh toán và máy quét.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T22",
      "speaker_id": "B",
      "text_en": "That's fine. I'm particularly comfortable explaining access routes because I have helped at community events before.",
      "translation_vi": "Được. Tôi khá quen giải thích đường đi dễ tiếp cận vì từng giúp các sự kiện cộng đồng.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T23",
      "speaker_id": "A",
      "text_en": "Please complete the online registration by Monday at noon. We'll email your final shift allocation after checking your details.",
      "translation_vi": "Hãy hoàn thành đăng ký trực tuyến trước trưa thứ Hai. Chúng tôi email phân ca cuối sau khi kiểm tra thông tin.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "volunteering",
        "registration",
        "training",
        "shifts",
        "uniform"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T24",
      "speaker_id": "B",
      "text_en": "I'll do it tonight. See you on Wednesday for orientation, and then Saturday afternoon for the festival.",
      "translation_vi": "Tôi đăng ký tối nay. Hẹn thứ Tư hướng dẫn và chiều thứ Bảy trong lễ hội.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
