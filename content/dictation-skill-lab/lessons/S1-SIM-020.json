  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "Southbank Watersports School, good morning. This is Leo. Are you looking for canoe lessons or a boating safety course?",
      "translation_vi": "Chào sáng, Trường Thể thao Nước Southbank, Leo đây. Chị tìm lớp chèo xuồng hay khóa an toàn lái thuyền?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "Boating safety. I sometimes go out on a small motorboat with friends, and I'd like to understand the rules myself.",
      "translation_vi": "An toàn lái thuyền. Tôi thỉnh thoảng đi thuyền máy nhỏ với bạn, muốn tự hiểu quy định.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "Our beginner course is called Safe Passage. It includes navigation markers, weather decisions and basic emergency procedures.",
      "translation_vi": "Khóa nhập môn tên Safe Passage, gồm biển báo hàng hải, quyết định theo thời tiết và xử lý khẩn cấp cơ bản.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "Safe Passage sounds useful. I saw an advanced course called Coastal Master, but that looks beyond my present experience.",
      "translation_vi": "Safe Passage hữu ích. Tôi thấy Coastal Master nâng cao nhưng quá sức hiện tại.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T05",
      "speaker_id": "A",
      "text_en": "The advanced option assumes people already recognise navigation signs and can make basic decisions without an instructor beside them.",
      "translation_vi": "Khóa nâng cao giả định học viên đã nhận biết biển chỉ dẫn hàng hải và tự quyết định cơ bản mà không cần người kèm.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "I'm not at that stage yet. I'd rather develop reliable habits in calm conditions before taking on more difficult routes.",
      "translation_vi": "Tôi chưa đạt mức đó. Tôi muốn có thói quen tốt ở điều kiện yên bình trước khi đi tuyến khó.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T07",
      "speaker_id": "A",
      "text_en": "It would be. The introductory course is intended for learners with little or no formal training, and no licence is required beforehand.",
      "translation_vi": "Đúng. Khóa nhập môn dành cho người ít hoặc chưa học chính thức; không cần có giấy phép trước.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "That's reassuring. Is the next class on Sunday? I'm normally busy with work during the week.",
      "translation_vi": "Yên tâm. Lớp tới vào Chủ nhật phải không? Trong tuần tôi thường bận làm.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T09",
      "speaker_id": "A",
      "text_en": "The next class is Saturday. Sunday is reserved for private groups, although we may offer public places later in the summer.",
      "translation_vi": "Lớp tới là thứ Bảy. Chủ nhật dành cho nhóm riêng, dù mùa hè có thể mở suất công khai.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "Saturday could work. Do we begin out on the water, or is there some classroom instruction first?",
      "translation_vi": "Thứ Bảy được. Chúng tôi bắt đầu ngoài nước hay học trong lớp trước?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "We start at eight fifty in the training room and go onto the water only after a safety briefing and equipment check.",
      "translation_vi": "Chúng tôi bắt đầu lúc tám giờ năm mươi trong phòng tập huấn, chỉ ra nước sau khi hướng dẫn an toàn và kiểm tra đồ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T12",
      "speaker_id": "B",
      "text_en": "Eight fifty is early enough. Is the training room inside the marina office, or somewhere on the far side of the harbour?",
      "translation_vi": "Tám giờ năm mươi hơi sớm. Phòng tập nằm trong văn phòng bến du thuyền hay ở phía bên kia cảng?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "It's in the blue building next to Pier Three. The marina office is on Pier One, which is easy to confuse on the map.",
      "translation_vi": "Phòng ở tòa nhà xanh cạnh cầu tàu Ba. Văn phòng bến ở cầu Một nên dễ nhầm bản đồ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T14",
      "speaker_id": "B",
      "text_en": "I'll find Pier Three. I own a life jacket, but it's quite old. Should I bring it for the practical session?",
      "translation_vi": "Tôi sẽ tìm cầu Ba. Tôi có áo phao nhưng đã cũ. Có nên mang để học thực hành không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "We'll provide approved life jackets. Please bring a waterproof jacket, since the wind can be cold even on a sunny morning.",
      "translation_vi": "Chúng tôi cấp áo phao đạt chuẩn. Hãy mang áo khoác chống nước vì gió lạnh cả khi trời nắng.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "I'll bring one. Are we expected to swim a long distance during the course? I'm comfortable in water but not particularly fast.",
      "translation_vi": "Tôi sẽ mang. Có phải bơi xa không? Tôi quen dưới nước nhưng không nhanh.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "There's no swimming test. You must be able to follow safety instructions and tell the instructor about any relevant medical limitations.",
      "translation_vi": "Không có bài kiểm tra bơi. Chị phải làm theo hướng dẫn an toàn và báo giáo viên về hạn chế sức khỏe liên quan.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "That's fine. How many learners are in the boat at once? I learn better when the instructor can watch what I'm doing.",
      "translation_vi": "Được. Mỗi lần có bao nhiêu học viên trên thuyền? Tôi học tốt hơn khi được giáo viên quan sát.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "We allow four learners per boat. Two instructors supervise the course, and everyone gets a turn handling the controls.",
      "translation_vi": "Chúng tôi cho bốn học viên mỗi thuyền. Hai giáo viên giám sát, ai cũng được thử điều khiển.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "Good. Is there an exam at the end? I'm not trying to gain a professional qualification, just safer habits.",
      "translation_vi": "Tốt. Cuối khóa có thi không? Tôi không cần chứng chỉ nghề, chỉ muốn thói quen an toàn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T21",
      "speaker_id": "A",
      "text_en": "There is a short practical assessment. Successful participants receive a certificate of attendance, not a licence to operate commercial boats.",
      "translation_vi": "Có đánh giá thực hành ngắn. Ai đạt nhận giấy chứng nhận tham dự, không phải giấy phép lái thuyền thương mại.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T22",
      "speaker_id": "B",
      "text_en": "That's all I need. What's the fee, and does it include the boat and safety equipment?",
      "translation_vi": "Đúng nhu cầu. Học phí bao nhiêu, đã gồm thuyền và thiết bị an toàn chưa?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T23",
      "speaker_id": "A",
      "text_en": "The course costs sixty-eight pounds, including equipment. If high winds prevent the practical session, we offer a free replacement date.",
      "translation_vi": "Khóa giá sáu mươi tám bảng, gồm thiết bị. Nếu gió mạnh không thể thực hành, chúng tôi cho lịch học bù miễn phí.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T24",
      "speaker_id": "B",
      "text_en": "Please reserve a place for Saturday. I'll arrive at the blue building before eight fifty with my waterproof jacket.",
      "translation_vi": "Hãy giữ chỗ thứ Bảy. Tôi sẽ đến tòa nhà xanh trước tám giờ năm mươi với áo chống nước.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "course_booking",
        "safety_equipment",
        "entry_requirements",
        "schedules",
        "certificate"
      ],
      "bank_role": "protected_assessment"
    }
  ],
