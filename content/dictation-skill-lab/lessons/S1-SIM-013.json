  ],
  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "Happy Tails Grooming, good afternoon. This is Mia. Would you like to book for a dog or ask about our cat service?",
      "translation_vi": "Chào chiều, Tiệm làm đẹp thú cưng Happy Tails, Mia đây. Chị muốn đặt cho chó hay hỏi dịch vụ mèo?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "For a dog, please. I've adopted a small spaniel, and I'd like to book her first professional grooming appointment.",
      "translation_vi": "Tôi đặt cho chó. Tôi mới nhận nuôi spaniel nhỏ và muốn đặt buổi chăm sóc chuyên nghiệp đầu tiên.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "Congratulations. Our first-visit package is called Gentle Start. It's designed for nervous dogs and includes breaks between stages.",
      "translation_vi": "Chúc mừng. Gói lần đầu tên Gentle Start, dành cho chó dễ lo lắng, có nghỉ giữa các bước.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "Gentle Start would be best. She was quite frightened at the vet last week, so I don't want to rush her.",
      "translation_vi": "Gentle Start hợp nhất. Tuần trước nó sợ ở bác sĩ thú y nên tôi không muốn thúc ép.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T05",
      "speaker_id": "A",
      "text_en": "What's her name? We label the appointment card, because sometimes two dogs of the same breed arrive together.",
      "translation_vi": "Tên nó là gì? Chúng tôi ghi trên thẻ lịch vì đôi khi hai chó cùng giống đến cùng lúc.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "Her name is Pippa, P I P P A. She responds much better to her name than to a whistle.",
      "translation_vi": "Tên nó là Pippa, P I P P A. Nó phản ứng với tên tốt hơn tiếng huýt sáo.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T07",
      "speaker_id": "A",
      "text_en": "Pippa, lovely. She's a small dog, so a first visit is normally around an hour, not the ninety minutes we reserve for large breeds.",
      "translation_vi": "Pippa, dễ thương. Chó nhỏ nên lần đầu thường khoảng một giờ, không phải chín mươi phút dành cho chó lớn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "An hour should be fine. I'm off work on Monday, although the nursery run makes early mornings difficult.",
      "translation_vi": "Một giờ thì được. Tôi nghỉ làm thứ Hai, dù đưa con đến nhà trẻ khiến sáng sớm khó sắp xếp.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T09",
      "speaker_id": "A",
      "text_en": "Our next Monday appointment is at eleven ten. We also have eight thirty, but that wouldn't fit your morning routine.",
      "translation_vi": "Lịch trống thứ Hai tới là mười một giờ mười. Có cả tám rưỡi nhưng không hợp lịch sáng của chị.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "Eleven ten is perfect. Does the package include nail trimming? Her claws are rather long at the moment.",
      "translation_vi": "Mười một giờ mười rất phù hợp. Gói có cắt móng không? Móng nó khá dài.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "Yes, nail trimming and a gentle wash are included. Teeth cleaning is a different service, and we won't add it without asking.",
      "translation_vi": "Có cắt móng và tắm nhẹ. Vệ sinh răng là dịch vụ khác, không tự thêm khi chưa hỏi.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T12",
      "speaker_id": "B",
      "text_en": "Please leave out teeth cleaning for now. She has a sensitive stomach and hasn't liked new treatments since her adoption.",
      "translation_vi": "Chưa làm vệ sinh răng nhé. Nó nhạy dạ dày và không quen điều trị mới từ khi được nhận nuôi.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "That's fine. We use fragrance-free shampoo for dogs with sensitive skin. Let us know about any diagnosed conditions in advance.",
      "translation_vi": "Được. Chúng tôi dùng dầu tắm không hương liệu cho chó da nhạy cảm. Hãy báo trước bệnh đã chẩn đoán.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T14",
      "speaker_id": "B",
      "text_en": "No diagnosed skin condition, but I'd prefer the fragrance-free shampoo anyway. Strong smells sometimes make her sneeze.",
      "translation_vi": "Không có bệnh da được chẩn đoán, nhưng tôi thích dầu không mùi. Mùi mạnh đôi khi làm nó hắt hơi.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "I'll note that preference. The Gentle Start package is thirty-four pounds, with no extra fee for the special shampoo.",
      "translation_vi": "Tôi ghi lại. Gói Gentle Start giá ba mươi bốn bảng, không phụ thu dầu đặc biệt.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "Good. Is there anything I should bring besides her lead? She's only been with us for three weeks.",
      "translation_vi": "Tốt. Tôi nên mang gì ngoài dây dắt? Nó mới ở với nhà tôi ba tuần.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "Please bring her vaccination record. We also advise owners not to feed a large meal immediately before the appointment.",
      "translation_vi": "Hãy mang hồ sơ tiêm chủng. Chúng tôi cũng khuyên không cho ăn bữa lớn ngay trước buổi hẹn.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "I have the record in a folder. Could I stay with her in the grooming room? She gets distressed when I leave.",
      "translation_vi": "Tôi có hồ sơ trong bìa. Tôi ở lại phòng chăm sóc được không? Nó buồn khi tôi đi.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "Owners may wait in reception, but we keep the grooming room quiet. We'll phone you if she struggles and needs a break.",
      "translation_vi": "Chủ có thể đợi ở quầy, nhưng phòng chăm sóc cần yên tĩnh. Chúng tôi gọi nếu chó quá căng và cần nghỉ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "I'll wait at reception. I noticed parking spaces in front, though the sign suggests they're reserved for another business.",
      "translation_vi": "Tôi sẽ đợi ở quầy. Tôi thấy chỗ đỗ phía trước nhưng biển ghi dành cho doanh nghiệp khác.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T21",
      "speaker_id": "A",
      "text_en": "Use the short-stay parking behind the bakery. Please don't park in the florist's spaces, even if they happen to be empty.",
      "translation_vi": "Hãy dùng bãi đỗ ngắn hạn phía sau tiệm bánh. Đừng đỗ chỗ tiệm hoa dù đang trống.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T22",
      "speaker_id": "B",
      "text_en": "Thanks, Mia. I'll bring Pippa's vaccination record and arrive a little before eleven ten on Monday.",
      "translation_vi": "Cảm ơn Mia. Tôi sẽ mang hồ sơ tiêm chủng của Pippa và đến trước mười một giờ mười thứ Hai.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "booking",
        "pet_care",
        "service_choices",
        "timing",
        "health_information"
      ],
      "bank_role": "protected_assessment"
    }
  ],
