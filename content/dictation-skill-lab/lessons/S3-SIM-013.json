      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T19",
      "speaker_id": "B",
      "text_en": "The poster should state the instrument model, calibration date and sampling conditions.",
      "meaning_vi": "B: Poster cần nêu máy đo, ngày hiệu chuẩn và điều kiện lấy mẫu.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
