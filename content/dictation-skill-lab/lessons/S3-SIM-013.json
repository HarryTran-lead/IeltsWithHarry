      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T16",
      "speaker_id": "A",
      "text_en": "The optional health questionnaires contain sensitive details unrelated to our noise comparison. Restrict access and remove identifiers from anything exported.",
      "meaning_vi": "A: Hạn chế truy cập và xóa định danh trong bảng hỏi sức khỏe.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T17",
      "speaker_id": "B",
      "text_en": "Use the traffic authority site to explain the route conditions, not as a substitute for our own exposure readings.",
      "meaning_vi": "B: Trang giao thông chỉ cung cấp bối cảnh tuyến.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
