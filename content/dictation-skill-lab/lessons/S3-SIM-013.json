      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T15",
      "speaker_id": "C",
      "text_en": "We can show each short peak beside the route condition recorded at that time.",
      "meaning_vi": "C: Có thể đặt đỉnh âm cạnh điều kiện tuyến đường ở thời điểm đó.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
