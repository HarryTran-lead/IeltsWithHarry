      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "We should not group all bus rides together if some involved an open window and others did not. Those details belong in the metadata alongside the sound readings.",
      "meaning_vi": "B: Ghi việc cửa xe mở hay đóng bên cạnh số đo, không gộp mọi chuyến buýt như nhau.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
