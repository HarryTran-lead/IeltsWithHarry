      "turn_id": "T01",
      "speaker_id": "C",
      "text_en": "The campus wants evidence about whether a rooftop garden improves conditions for people using the building.",
      "meaning_vi": "C: Trường cần bằng chứng về tác dụng vườn mái; B đã đo nhiệt độ trước khi trồng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
