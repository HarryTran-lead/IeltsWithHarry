  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "C",
      "text_en": "The first-year mentoring programme has many positive testimonials.",
      "meaning_vi": "C: Chương trình cố vấn có nhiều lời khen nhưng sinh viên học tối tham gia ít; phải xét cả người không tham gia.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "But fewer students from the evening cohort signed up.",
      "meaning_vi": "C: Chương trình cố vấn có nhiều lời khen nhưng sinh viên học tối tham gia ít; phải xét cả người không tham gia.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "Your evaluation should include those who did not participate as well as those who did.",
      "meaning_vi": "C: Chương trình cố vấn có nhiều lời khen nhưng sinh viên học tối tham gia ít; phải xét cả người không tham gia.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "Nearly all our positive feedback came from students who completed the programme. Those who stopped attending were barely represented, so the sample is biased toward satisfied users.",
      "meaning_vi": "B: Phản hồi chủ yếu từ người học đến cuối, thiếu ý kiến người bỏ giữa chừng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T05",
      "speaker_id": "A",
      "text_en": "Meeting counts are easy to report, but the programme exists to help new students navigate support. Test whether they can identify where to seek academic help when they face a problem.",
      "meaning_vi": "A: Đo khả năng nhận diện nơi tìm hỗ trợ học tập, không phải đếm cuộc họp.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T06",
      "speaker_id": "A",
      "text_en": "Some students met their mentors only by email. That may count as contact, but it does not provide the same opportunity as a small group session, so define participation carefully.",
      "meaning_vi": "A: Liên hệ qua email không tương đương buổi gặp nhóm; cần định nghĩa tham gia rõ ràng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T07",
      "speaker_id": "C",
      "text_en": "The feedback already tells us scheduling is a problem worth fixing.",
      "meaning_vi": "C: Phản hồi đã cho thấy lịch hẹn là vấn đề cần sửa.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T08",
      "speaker_id": "C",
      "text_en": "We first assumed evening students disliked mentoring. Interviews suggest something simpler: most meetings were scheduled while they were in lectures, so attendance was impossible.",
      "meaning_vi": "C: Sinh viên học tối ít tham gia vì lịch gặp trùng giờ học.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T09",
      "speaker_id": "B",
      "text_en": "Rather than making attendance mandatory, let us rotate meeting times and test whether participation becomes more balanced across cohorts.",
      "meaning_vi": "B: Thử xoay vòng giờ gặp thay vì bắt buộc tham gia.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "We should avoid turning the report into a judgement about individual mentors.",
      "meaning_vi": "B: Không nên biến báo cáo thành đánh giá từng cố vấn.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "It would be irresponsible to claim mentoring reduced withdrawals without a proper comparison. Financial pressures, course difficulty and timetable problems also influence whether students stay.",
      "meaning_vi": "A: Tỷ lệ bỏ học chịu nhiều yếu tố khác ngoài cố vấn.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T12",
      "speaker_id": "C",
      "text_en": "Keep the positive testimonials, clearly noting that they come from those who remained in the programme.",
      "meaning_vi": "C: Giữ lời khen nhưng nêu mẫu là người tham gia đến cuối.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T13",
      "speaker_id": "C",
      "text_en": "We need to ask non-participants why they did not enrol without implying they were irresponsible. The timetable may have excluded them before motivation became relevant.",
      "meaning_vi": "C: Hỏi người không tham gia bằng giọng trung tính; lịch có thể là rào cản chứ không phải thiếu động lực.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T14",
      "speaker_id": "A",
      "text_en": "Use the support-navigation task as the main indicator of whether students know how to seek academic help.",
      "meaning_vi": "A: Bài tìm nguồn hỗ trợ là chỉ số đánh giá chính.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "Show the participation rate separately for daytime and evening students.",
      "meaning_vi": "A: Hãy tách tỷ lệ tham gia của sinh viên học ngày và học tối.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "The attendance logs describe participation patterns, but they do not demonstrate improved learning on their own.",
      "meaning_vi": "B: Nhật ký tham gia chỉ mô tả mức dự họp.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "Remove student phone numbers and private email addresses before sharing programme-level data with the evaluators.",
      "meaning_vi": "A: Xóa số điện thoại và email riêng khỏi dữ liệu đánh giá.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "A trial of rotating times should compare access across cohorts rather than just produce a higher total attendance number. Fairness is part of the programme’s stated purpose.",
      "meaning_vi": "B: Thử xoay giờ phải xem khả năng tiếp cận giữa các nhóm, không chỉ tổng người tham gia.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T19",
      "speaker_id": "C",
      "text_en": "The next-term trial can test the schedule change without changing the entire programme at once.",
      "meaning_vi": "C: Học kỳ sau có thể thử đổi lịch trước khi thay toàn bộ chương trình.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T20",
      "speaker_id": "C",
      "text_en": "The withdrawal questionnaire was never piloted with students who had left. We need to test whether its wording is appropriate and understandable.",
      "meaning_vi": "C: Bảng hỏi bỏ học cần thử với nhóm phù hợp trước khi dùng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T21",
      "speaker_id": "A",
      "text_en": "One further caution: a student who has a helpful mentor might still withdraw for financial reasons, while another might stay despite never meeting a mentor. That is why we should keep the outcome task focused on navigating support, rather than treating every enrolment decision as caused by this one programme.",
      "meaning_vi": "A: Sinh viên có cố vấn tốt vẫn có thể nghỉ vì tiền bạc; không được gán mọi quyết định học tiếp cho chương trình cố vấn.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "final_critical_discussion"
    },
    {
      "turn_id": "T22",
      "speaker_id": "B",
      "text_en": "We should recommend improvements that can be tested next term, not claim the programme has already solved retention problems.",
      "meaning_vi": "B: Nên đề xuất cải tiến thử học kỳ sau, không nói chương trình đã giải quyết bỏ học.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
