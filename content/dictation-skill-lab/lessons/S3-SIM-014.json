  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "C",
      "text_en": "We expected older halls to have the worst ventilation.",
      "meaning_vi": "C: Tưởng ký túc xá cũ thông gió kém nhất nhưng số đo không phản ánh vậy.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
