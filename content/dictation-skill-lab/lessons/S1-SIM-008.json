    }
  ],
  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "A",
      "text_en": "Central Station luggage desk. Emma speaking. Are you calling about lost property, or would you like to leave a bag with us?",
      "translation_vi": "Quầy hành lý ga Trung tâm, Emma đây. Anh gọi về đồ thất lạc hay muốn gửi hành lý?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T02",
      "speaker_id": "B",
      "text_en": "I'd like to leave a suitcase. My train arrives early tomorrow, but my hotel won't let me check in until the afternoon.",
      "translation_vi": "Tôi muốn gửi va li. Tàu đến sớm ngày mai nhưng khách sạn chiều mới cho nhận phòng.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T03",
      "speaker_id": "A",
      "text_en": "No problem. The service is called Left Luggage. Lost property is handled by the railway company upstairs, so you've reached the right desk.",
      "translation_vi": "Không vấn đề. Dịch vụ tên Left Luggage. Đồ thất lạc do công ty đường sắt tầng trên xử lý, anh gọi đúng quầy.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T04",
      "speaker_id": "B",
      "text_en": "Good. I'll have one large suitcase and a small backpack. Do both count as separate items, or can I pack them together?",
      "translation_vi": "Tốt. Tôi có một va li lớn và ba lô nhỏ. Tính riêng hay gộp được?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T05",
      "speaker_id": "A",
      "text_en": "Each stored piece counts separately. If the backpack fits inside the suitcase, we'll charge only for the case you hand over.",
      "translation_vi": "Mỗi món gửi tính riêng. Nếu ba lô nằm trong va li, chỉ tính va li anh giao.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T06",
      "speaker_id": "B",
      "text_en": "I'll put the backpack inside, then. The case is quite heavy, though; is there a maximum weight?",
      "translation_vi": "Tôi sẽ để ba lô trong va li. Nhưng va li khá nặng, có giới hạn cân nặng không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T07",
      "speaker_id": "A",
      "text_en": "We accept cases up to twenty kilograms. Anything heavier must go to the staffed parcel counter near platform eight.",
      "translation_vi": "Chúng tôi nhận va li tối đa hai mươi kg. Nặng hơn phải tới quầy kiện hàng có nhân viên gần sân ga tám.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T08",
      "speaker_id": "B",
      "text_en": "Mine is about eighteen kilograms, so that should be fine. When does the luggage desk open in the morning?",
      "translation_vi": "Va li khoảng mười tám kg, vậy được. Quầy mở cửa buổi sáng lúc nào?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T09",
      "speaker_id": "A",
      "text_en": "We open at seven fifteen. The website still says seven, but that was before the revised winter timetable.",
      "translation_vi": "Chúng tôi mở bảy giờ mười lăm. Website còn ghi bảy giờ, đó là lịch mùa đông cũ.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T10",
      "speaker_id": "B",
      "text_en": "My train arrives at seven twenty-five, so I won't have to wait long. Is there an entrance closer than the main station hall?",
      "translation_vi": "Tàu đến bảy giờ hai mươi lăm, không phải chờ lâu. Có lối vào gần hơn sảnh chính không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T11",
      "speaker_id": "A",
      "text_en": "The desk is beside the north exit. It's just beyond the ticket machines; avoid the south tunnel because it's being repaired.",
      "translation_vi": "Quầy cạnh cửa ra phía bắc, ngay sau máy bán vé. Tránh đường hầm phía nam đang sửa.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T12",
      "speaker_id": "B",
      "text_en": "That will save time. How much is the charge if I leave the case until about four in the afternoon?",
      "translation_vi": "Tiết kiệm thời gian. Phí bao nhiêu nếu tôi gửi tới khoảng bốn giờ chiều?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T13",
      "speaker_id": "A",
      "text_en": "For up to twelve hours, the price is eleven pounds. The shorter four-hour option is six pounds, but it wouldn't cover your visit.",
      "translation_vi": "Tối đa mười hai giờ giá mười một bảng. Gói bốn giờ là sáu bảng nhưng không đủ chuyến đi.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T14",
      "speaker_id": "B",
      "text_en": "I'll pay for twelve hours. Is there a printed ticket to collect the bag, or do you send a code to my phone?",
      "translation_vi": "Tôi chọn mười hai giờ. Có phiếu giấy nhận va li hay mã gửi điện thoại?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "We issue a printed receipt with a collection number. Please keep it, as staff need to see it when you return.",
      "translation_vi": "Chúng tôi cấp biên lai in có mã nhận. Hãy giữ vì nhân viên cần xem khi quay lại.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T16",
      "speaker_id": "B",
      "text_en": "I sometimes lose small slips of paper. Would a photograph of the receipt work if the original disappears?",
      "translation_vi": "Tôi hay làm mất giấy nhỏ. Chụp ảnh biên lai có dùng được nếu mất bản gốc không?",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T17",
      "speaker_id": "A",
      "text_en": "A photo alone isn't enough. We would also need an identity document and a description of the case before releasing it.",
      "translation_vi": "Chỉ ảnh là không đủ. Chúng tôi cần thêm giấy tờ tùy thân và mô tả va li trước khi trả.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T18",
      "speaker_id": "B",
      "text_en": "Understood. My suitcase has a red strap. I'll keep the receipt safely inside my jacket instead of putting it in another bag.",
      "translation_vi": "Hiểu rồi. Va li có dây đỏ. Tôi sẽ giữ biên lai trong áo khoác thay vì bỏ vào túi khác.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T19",
      "speaker_id": "A",
      "text_en": "One safety rule: we won't store loose batteries or camping fuel, even if they're packed carefully with clothing.",
      "translation_vi": "Một quy định an toàn: không nhận pin rời hoặc nhiên liệu cắm trại, dù đóng gói cẩn thận với quần áo.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T20",
      "speaker_id": "B",
      "text_en": "I have a power bank in the backpack. I'll carry that with me and leave only clothes inside the suitcase.",
      "translation_vi": "Tôi có sạc dự phòng trong ba lô. Tôi sẽ mang theo và chỉ để quần áo trong va li.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T21",
      "speaker_id": "A",
      "text_en": "Payment is by card or contactless. Our cash machine was removed last month, and the desk no longer accepts banknotes.",
      "translation_vi": "Thanh toán bằng thẻ hoặc chạm. Máy thu tiền mặt đã dỡ tháng trước, quầy không nhận tiền giấy.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    },
    {
      "turn_id": "T22",
      "speaker_id": "B",
      "text_en": "Fine, I've got a bank card. Thank you for explaining everything; I'll find the north exit tomorrow morning.",
      "translation_vi": "Được, tôi có thẻ ngân hàng. Cảm ơn đã giải thích; sáng mai tôi sẽ tìm cửa bắc.",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "ielts_part_1",
        "travel_services",
        "opening_hours",
        "prices",
        "safety",
        "payment"
      ],
      "bank_role": "protected_assessment"
    }
  ],
