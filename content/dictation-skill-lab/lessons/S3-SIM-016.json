  "turns": [
    {
      "turn_id": "T01",
      "speaker_id": "B",
      "text_en": "We have three versions of a historical broadcast, but the audio quality and dates disagree.",
      "meaning_vi": "B: Có ba bản ghi chương trình phát thanh cổ với ngày tháng khác nhau; cần xác minh nguồn trước khi phục chế.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T02",
      "speaker_id": "A",
      "text_en": "That is a problem of provenance before it is a problem of sound restoration.",
      "meaning_vi": "B: Có ba bản ghi chương trình phát thanh cổ với ngày tháng khác nhau; cần xác minh nguồn trước khi phục chế.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "scene_setup"
    },
    {
      "turn_id": "T03",
      "speaker_id": "C",
      "text_en": "Keep a photograph of the box label, but explain that the annotation was added much later and cannot establish the broadcast date.",
      "meaning_vi": "C: Giữ ảnh nhãn hộp nhưng ghi chú ngày thêm sau.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T04",
      "speaker_id": "A",
      "text_en": "The station ledger is our strongest independent record of when the programme actually aired.",
      "meaning_vi": "A: Sổ lịch phát sóng là chứng cứ độc lập chính.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T05",
      "speaker_id": "B",
      "text_en": "The file transfers are another source of uncertainty. Each time an archive copy was made, someone may have changed playback speed or introduced new noise without documenting it.",
      "meaning_vi": "B: Mỗi lần sao chép lưu trữ có thể đổi tốc độ hoặc thêm nhiễu mà không ghi lại.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T06",
      "speaker_id": "C",
      "text_en": "It is easy to mistake a cleaner sound for a more historically accurate recording.",
      "meaning_vi": "C: Âm thanh sạch hơn không nhất thiết đúng lịch sử hơn.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T07",
      "speaker_id": "B",
      "text_en": "Exclude the version produced with the strongest filter. Several consonants are missing and we cannot reverse that processing reliably.",
      "meaning_vi": "B: Loại bản lọc nhiễu quá mạnh làm mất phụ âm.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T08",
      "speaker_id": "C",
      "text_en": "The studio photograph will help visitors imagine the equipment, but it cannot confirm which recording they are listening to.",
      "meaning_vi": "C: Ảnh studio chỉ minh họa thiết bị.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T09",
      "speaker_id": "B",
      "text_en": "We should keep both the raw file and the edited version so every step is reversible.",
      "meaning_vi": "B: Cần giữ tệp gốc và bản đã sửa để có thể đảo ngược các bước.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T10",
      "speaker_id": "A",
      "text_en": "The performer’s contract has restrictions we do not understand. Ask the archive rights officer before publishing the reconstructed voice clip.",
      "meaning_vi": "A: Phải hỏi cán bộ bản quyền trước khi công bố đoạn diễn lại.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T11",
      "speaker_id": "C",
      "text_en": "The label says 1937, but that date was written on the box in the 1970s. We cannot assume the recording was made in 1937 simply because somebody annotated it later.",
      "meaning_vi": "C: Năm ghi trên hộp được thêm nhiều thập kỷ sau, không chứng minh năm thu.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T12",
      "speaker_id": "A",
      "text_en": "Never edit the only surviving source file. Work from a checksum-verified copy and record every filter and speed adjustment, because future researchers may interpret the recording differently.",
      "meaning_vi": "A: Không sửa tệp nguồn duy nhất; dùng bản sao kiểm tra checksum và lưu mọi bước lọc.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T13",
      "speaker_id": "B",
      "text_en": "The noise filter removes hiss, but it also cuts the quieter consonants from the presenter’s voice. Cleaning the recording too aggressively could erase evidence rather than recover it.",
      "meaning_vi": "B: Lọc nhiễu quá mạnh có thể xóa phụ âm nhỏ trong giọng gốc.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T14",
      "speaker_id": "A",
      "text_en": "If the archival record remains contradictory, say so in the gallery label.",
      "meaning_vi": "A: Nếu hồ sơ lưu trữ mâu thuẫn, phải nói rõ trong nhãn triển lãm.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T15",
      "speaker_id": "A",
      "text_en": "Before guessing from the accent, compare the surviving station programme schedules. If a particular speech was broadcast on only one date, that gives us a stronger starting point.",
      "meaning_vi": "A: Đối chiếu lịch phát thanh còn lưu thay vì đoán từ giọng nói.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T16",
      "speaker_id": "C",
      "text_en": "The final exhibition could include a modern actor reading a missing announcement. That is acceptable if the replacement is clearly labelled as a reconstruction, not passed off as the surviving broadcast.",
      "meaning_vi": "C: Phần diễn đọc thay phải gắn nhãn phục dựng rõ ràng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T17",
      "speaker_id": "C",
      "text_en": "The visitor should be able to hear how our interpretation changes when the uncertain date is accepted or rejected. That makes the reconstruction an argument, not just a polished sound clip.",
      "meaning_vi": "C: Khách nên nghe khác biệt giữa hai cách hiểu niên đại, không chỉ một clip được đánh bóng.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "critical_discussion"
    },
    {
      "turn_id": "T18",
      "speaker_id": "C",
      "text_en": "I will prepare a short listening comparison that does not conceal the original hiss.",
      "meaning_vi": "C: Tôi sẽ chuẩn bị phần so sánh nghe mà không che tiếng nhiễu gốc.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "peer_response"
    },
    {
      "turn_id": "T19",
      "speaker_id": "B",
      "text_en": "The most interesting story is how we decide which copy is trustworthy. Visitors can hear two versions and examine the records that support or challenge each one.",
      "meaning_vi": "B: Triển lãm giải thích cách đánh giá các bản ghi cạnh tranh.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "evidence"
    },
    {
      "turn_id": "T20",
      "speaker_id": "A",
      "text_en": "A transparent reconstruction can be fascinating, provided the audience knows which sounds are authentic and which are modern interpretations.",
      "meaning_vi": "A: Bản phục dựng phải phân biệt âm thanh gốc và phần diễn giải hiện đại.",
      "translation_vi": null,
      "translation_status": "pending_full_sentence_human_translation",
      "start_ms": null,
      "end_ms": null,
      "skill_tags": [
        "part3_opinion_tracking",
        "paraphrase",
        "evidence_evaluation"
      ],
      "bank_role": "protected_assessment",
      "discourse_role": "conclusion"
    }
