      "question_id": "Q09",
      "group_id": "PART1_MCQ_7_TO_10",
      "type": "mcq",
      "prompt": "What happens if a book is overdue by more than a month?",
      "correct_answers": [
        "Further borrowing is suspended"
      ],
      "options": [
