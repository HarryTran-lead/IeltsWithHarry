  "teacher_notes": {
    "goal": "Nhận ra lựa chọn cuối cùng sau khi người nói chỉnh sửa hoặc loại bỏ phương án trước.",
    "theory": "Đáp án đúng phải khớp quyết định cuối cùng. Các phương án được nhắc tới nhưng sau đó bị bác bỏ là bẫy điển hình.",
    "tip": "Gạch nháp từ thay đổi: actually, instead, not, rather than, but, in the end. Nghe cả lượt sau trước khi chốt.",
    "mistakes": [
      "Chọn ngay số/địa điểm được nhắc đầu tiên.",
      "Đồng nhất chữ giống trong lựa chọn với đáp án chính xác."
    ],
    "worked_example": "Ví dụ ngoài đề: “I wanted Tuesday, but Thursday is the only available day.” → Chốt Thursday, không phải Tuesday."
  },
