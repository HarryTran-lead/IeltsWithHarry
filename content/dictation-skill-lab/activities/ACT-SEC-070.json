  "teacher_notes": {
    "goal": "Xác định ai đề xuất, đồng ý hoặc nhận trách nhiệm trong hội thoại nhiều người.",
    "theory": "Matching theo người nói yêu cầu gắn ý với đúng nguồn phát biểu. Người thứ hai có thể chỉ nhắc lại ý của người thứ nhất.",
    "tip": "Theo dõi A/B/C, và từ chỉ vai trò: I can…, let me…, I suggest…; kiểm tra phát biểu của đúng người.",
    "mistakes": [
      "Gắn đề xuất cho người tán thành thay vì người đề xuất.",
      "Nhầm lượt thoại liền kề có cùng chủ đề."
    ],
    "worked_example": "Ví dụ ngoài đề: Student B says “I’ll analyse the data”; Student C says “Great idea”. → Nhiệm vụ phân tích thuộc B."
  },
