  "teacher_notes": {
    "goal": "Nghe tín hiệu nêu nguyên nhân, hệ quả, tương phản và trình tự trong bài giảng.",
    "theory": "Signpost cho biết cách ý sau liên quan tới ý trước. Nhận đúng từ nối giúp dự đoán phần giảng tiếp theo.",
    "tip": "Nghe cụm chuyển ý trước và sau dấu ngắt, đừng đoán chức năng chỉ từ chủ đề.",
    "mistakes": [
      "Nhầm therefore (hệ quả) với because (nguyên nhân).",
      "Bỏ qua however nên hiểu hai ý là bổ sung chứ không đối lập."
    ],
    "worked_example": "Ví dụ ngoài đề: “Rainfall increased. Therefore, runoff rose.” → Therefore đưa ra hệ quả."
  },
