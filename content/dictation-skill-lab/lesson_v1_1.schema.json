{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-skill-lab.invalid/schemas/dictation-lesson-1.1.json",
  "title": "English Skill Lab – Dictation Lesson v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "status",
    "level",
    "section",
    "topic",
    "title",
    "learning_objectives_vi",
    "content_format",
    "speakers",
    "turns",
    "questions",
    "vocabulary",
    "audio",
    "qa",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^(DICT-(F[123]|S[1234])-\\d{3}|EXAMPLE-(F[123]|S[1234])-\\d{3})$"
    },
    "status": {
      "enum": [
        "draft",
        "content_review",
        "tts_ready",
        "audio_generated",
        "audio_verified",
        "qa_passed",
        "published",
        "archived"
      ]
    },
    "level": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7"
      ]
    },
    "section": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "learning_objectives_vi": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_format": {
      "enum": [
        "micro_drill",
        "sentence_drill",
        "mini_conversation",
        "section_bridge",
        "section_practice"
      ]
    },
    "speakers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "speaker_id",
          "role",
          "tts_voice_id",
          "accent_requested"
        ],
        "properties": {
          "speaker_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "tts_voice_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "accent_requested": {
            "enum": [
              "british",
              "american",
              "australian",
              "neutral",
              "other",
              "new_zealand"
            ]
          }
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_id",
          "speaker_id",
          "text_en",
          "translation_vi",
          "start_ms",
          "end_ms",
          "skill_tags"
        ],
        "properties": {
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "speaker_id": {
            "type": "string",
            "minLength": 1
          },
          "text_en": {
            "type": "string",
            "minLength": 1
          },
          "translation_vi": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "end_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "skill_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "pos",
          "meaning_vi",
          "example_en",
          "example_vi",
          "source_turn_id"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "pos": {
            "type": "string",
            "minLength": 1
          },
          "meaning_vi": {
            "type": "string",
            "minLength": 1
          },
          "example_en": {
            "type": "string",
            "minLength": 1
          },
          "example_vi": {
            "type": "string",
            "minLength": 1
          },
          "source_turn_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "type",
          "prompt",
          "correct_answers",
          "evidence_turn_ids",
          "explanation_vi",
          "scoring_policy",
          "question_tags"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "word_choice",
              "dictation",
              "gap_fill",
              "mcq",
              "form_completion",
              "note_completion",
              "table_completion",
              "sentence_completion",
              "summary_completion",
              "matching",
              "map_labelling",
              "plan_labelling",
              "diagram_labelling",
              "short_answer",
              "true_false",
              "main_idea"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "correct_answers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_turn_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "explanation_vi": {
            "type": "string",
            "minLength": 1
          },
          "scoring_policy": {
            "enum": [
              "strict",
              "case_punctuation_insensitive",
              "controlled_variants",
              "manual_review"
            ]
          },
          "question_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "word_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "instructions_en": {
            "type": "string",
            "minLength": 1
          },
          "practice_aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "map_asset": {
            "type": "string",
            "minLength": 1
          },
          "editorial_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "url",
        "duration_ms",
        "model",
        "provider",
        "voice_config",
        "source_transcript_hash",
        "audio_sha256",
        "format"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_generated",
            "generated",
            "needs_review",
            "verified",
            "failed"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "voice_config": {
          "type": [
            "object",
            "null"
          ]
        },
        "source_transcript_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "audio_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_reviewed",
        "answers_verified",
        "audio_verified",
        "rights_cleared",
        "duplicate_reviewed",
        "notes"
      ],
      "properties": {
        "content_reviewed": {
          "type": "boolean"
        },
        "answers_verified": {
          "type": "boolean"
        },
        "audio_verified": {
          "type": "boolean"
        },
        "rights_cleared": {
          "type": "boolean"
        },
        "duplicate_reviewed": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_origin",
        "source_urls",
        "source_rights_note",
        "reviewer"
      ],
      "properties": {
        "content_origin": {
          "enum": [
            "original_human",
            "original_ai_assisted",
            "licensed",
            "public_domain"
          ]
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_rights_note": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "release_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "description": "M16.2 backward-compatible extension for IELTS instructions, reviewed scoring aliases, map assets and NZ accent request."
}
