# Local browser-only preview. Set to false after the Supabase project is ready.
NEXT_PUBLIC_DEMO_MODE=true

# Required for live mode. Copy project URL and publishable key from Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Turn on only after enabling the corresponding provider in Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false
NEXT_PUBLIC_EMAIL_DELIVERY_READY=false

# Cloudflare R2 media storage is planned; no upload route is enabled yet.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
