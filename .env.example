# Local browser-only preview. Set to false after the Supabase project is ready.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_COMMUNITY=false
NEXT_PUBLIC_SMART_NOTEBOOK_V1=false
# Set true only for the isolated develop Preview to show unfinished features.
NEXT_PUBLIC_UNLOCK_DEV_FEATURES=false

# Required for live mode. Copy project URL and publishable key from Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Turn on only after enabling the corresponding provider in Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false
NEXT_PUBLIC_EMAIL_DELIVERY_READY=false

# Daily News sync: server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Grammar practice labs: set false to hide the owner-approved drafts on a deployment.
GRAMMAR_DRAFT_PREVIEW=
NEWS_SYNC_SECRET=
IELTS_SYNC_SECRET=
# Writing grader is disabled by default. Enable only after DB migration, private worker,
# approved local model artifacts and teacher QA. Never use NEXT_PUBLIC_ for these keys.
WRITING_AUTOGRADING_ENABLED=false
WRITING_GRADING_PIPELINE_VERSION=local-v1
# Configure these only on the private worker host, not in the browser or Vercel.
WRITING_LOCAL_MODEL_URL=http://127.0.0.1:11434
WRITING_LOCAL_MODEL_ID=
WRITING_LOCAL_MODEL_REVISION=
# IELTS imports use the existing Supabase service role key above, server-side only.
# Optional server-only key. Enables ten evidence-checked AI questions for each eligible full-text article.
# Add this as a Production Environment Variable in Vercel; never use NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional comma-separated free-tier models, tried in order when one hits its quota (each model has its own limit).
# Defaults to gemini-3.5-flash-lite. Check model names and limits in Google AI Studio.
GEMINI_MODELS=
# Optional server-only Pollinations key (https://enter.pollinations.ai). When no licensed photo fits a story,
# an AI illustration is generated and stored in the news-ai-illustrations bucket. Without a key the free tier
# allows one image every 45 seconds, so each enrichment run generates one; with a key, up to three.
POLLINATIONS_API_KEY=
# Comma-separated exact HTTPS feed hosts permitted for RSS fetching.
NEWS_RSS_ALLOWED_HOSTS=www.nasa.gov,science.nasa.gov,earthobservatory.nasa.gov,www.noaa.gov

# Optional paid fallback for bilingual Daily News on browsers without Chrome's built-in Translator.
# Enable Cloud Translation Basic, restrict the key to that API, and set a Google Cloud quota.
GOOGLE_CLOUD_TRANSLATE_API_KEY=

# VOA Dictation: server-only HTTPS read domain backed by Cloudflare R2.
# Keep R2 write credentials in the offline importer, never in the browser.
R2_MEDIA_BASE_URL=
# Explicitly show unreviewed VOA trial lessons on the separate Dictation page.
NEXT_PUBLIC_VOA_PREVIEW=false
